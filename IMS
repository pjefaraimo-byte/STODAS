function renderRFGauges() {
  const g = document.getElementById("rf-gauges");
  if (!g) return;
  const key = APP_DATA.rfData.filter(r=>r.pct!==null).slice(0,6);
  g.innerHTML = key.map(r => {
    const pct = Math.min(r.pct || 0, 100);
    const col = pct>=80?"var(--green)":pct>=30?"var(--blue)":"var(--red)";
    const label = r.indicator.split(" ").slice(0,5).join(" ");
    // SVG semicircle meter: 180° arc, cx=60,cy=60,r=46
    const cx=60, cy=62, R=46;
    const circumference = Math.PI * R; // half circle
    const offset = circumference * (1 - pct/100);
    // track arc path (grey)
    const trackD = `M ${cx-R},${cy} A ${R},${R} 0 0,1 ${cx+R},${cy}`;
    // fill arc using stroke-dasharray on the same path
    return `<div style="background:var(--white);border-radius:var(--radius);box-shadow:var(--shadow);padding:12px 8px 8px;text-align:center;cursor:pointer;" onclick="filterRF('${r.level}')">
