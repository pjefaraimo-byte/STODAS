function deleteSurveyRecord(i) {
  if (!confirm("Delete household record '" + surveyRecords[i].id + "'? This cannot be undone.")) return;
  surveyRecords.splice(i, 1);
  _saveSurveyRecords();
  renderSurveyList();
  showToast("Record deleted.", "");
}

function jumpSection(idx) {
  const secs = document.querySelectorAll(".sf-section");
  secs.forEach((s,i) => {
    const header = s.querySelector(".sf-section-header");
    const body = s.querySelector(".sf-body");
    if (i === idx) {
      header.classList.remove("collapsed");
      body.style.display = "";
      s.scrollIntoView({ behavior:"smooth", block:"start" });
    }
    // Don't close other sections — let user see all
  });
  // Update nav buttons
  document.querySelectorAll(".sf-nav-btn").forEach((b,i) => b.classList.toggle("active", i===idx));
  // Update progress
  const fill = document.getElementById("sfProgressFill");
  if (fill) fill.style.width = Math.round((idx+1)/9*100) + "%";
}

function toggleSFSection(idx) {
  const sec = document.getElementById("sf-sec-"+idx);
  if (!sec) return;
  const header = sec.querySelector(".sf-section-header");
  const body = sec.querySelector(".sf-body");
  const isCollapsed = header.classList.contains("collapsed");
  header.classList.toggle("collapsed", !isCollapsed);
  body.style.display = isCollapsed ? "" : "none";
}

function exportSurveyCSV() {
  if (!surveyRecords.length) { showToast("No records to export.", "red"); return; }
  const headers = ["HH_ID","Country","Village","Interview_Date","Respondent","Sex","Age",
    "Total_Members","Female_Headed","Education","Livelihood",
    "Land_Area","Land_Unit","Land_Tenure","Crop1","Crop2","Crop3",
    "Livestock","Inputs","Received_Training",
    "Prod_Change","Income_Change","Food_Avail_Change",
    "FIES_Score","FIES_Severe","Climate_Shocks","CSA_Practices",
    "Farm_Condition","Interview_Quality","Saved_By","Saved_At"
  ];
  const rows = surveyRecords.map(r => {
    const fiesScore = Object.values(r.fies||{}).filter(v=>v==="Yes").length;
    const fiesSevere = [r.fies?.fies_7,r.fies?.fies_8].filter(v=>v==="Yes").length > 0 ? "Yes":"No";
    return [r.id,r.country,r.village,r.interviewDate,r.respondentName,r.sex,r.age,
      r.totalMembers,r.femaleHeaded,r.education,(r.livelihood||[]).join("|"),
      r.landArea,r.landUnit,r.landTenure,r.crop1,r.crop2,r.crop3,
      (r.livestock||[]).join("|"),(r.inputs||[]).join("|"),r.receivedTraining,
      r.productionChange,r.incomeChange,r.foodAvailChange,
      fiesScore,fiesSevere,(r.climateShocks||[]).join("|"),(r.csaPractices||[]).join("|"),
      r.farmCondition,r.interviewQuality,r.savedBy,r.savedAt
    ].map(v => (v===undefined||v===null)?"":String(v).includes(",") ? `"${v}"` : v);
  });
  let csv = headers.join(",") + "\n" + rows.map(r=>r.join(",")).join("\n");
  const blob = new Blob([csv],{type:"text/csv"});
  const a = document.createElement("a"); a.href=URL.createObjectURL(blob);
  a.download = "STODAS_Survey_Data_"+new Date().toISOString().split("T")[0]+".csv";
  a.click(); URL.revokeObjectURL(a.href);
  showToast("Survey data exported as CSV.", "green");
}

window.addEventListener("load", () => {
