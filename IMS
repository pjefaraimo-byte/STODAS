  // Results_Framework sheet
  const rfHeaders = ["indicator_id","level","indicator","type","baseline","prog_y1","target_y2","prog_y2","total_target","cumulative","pct","comments"];
  const rfData = [rfHeaders];
  APP_DATA.rfData.forEach((r,i) => rfData.push([i+1,r.level,r.indicator,r.type,r.baseline,r.prog2024,r.y2target,r.prog2025,r.totalTarget,r.cumulative,r.pct||"",r.comments]));
