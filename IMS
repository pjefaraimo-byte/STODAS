function buildSearchIndex() {
  const index = [];
  const allInts = getAllInterventions();
  allInts.forEach(r => {
    index.push({type:"Intervention",label:r.name,sub:`${r.id} · ${r.status} · ${r.output}`,id:r.id,action:()=>openInterventionModal(r.id)});
  });
  APP_DATA.rfData.forEach(r => {
    index.push({type:"Indicator",label:r.indicator,sub:`${r.level} · ${r.cumulative}`,action:()=>{showTab("results");filterRF("all");}});
  });
  APP_DATA.loas.forEach(l => {
    index.push({type:"LOA/SC",label:l.name,sub:`${l.id} · ${l.status} · ${l.country}`,action:()=>openLoaModal(l.id)});
  });
  APP_DATA.budgetLines.forEach(r => {
    index.push({type:"Budget",label:r.desc,sub:`${r.cat} · Budget: ${fmtUSDFull(r.total)}`,action:()=>showTab("budget")});
  });
  return index;
}
let searchIndex = null;

function doSearch(q) {
  if (!q || q.length < 2) { document.getElementById("searchResults").style.display="none"; return; }
  if (!searchIndex) searchIndex = buildSearchIndex();
  const term = q.toLowerCase();
  const res = searchIndex.filter(r => r.label.toLowerCase().includes(term) || r.sub.toLowerCase().includes(term)).slice(0,10);
  const div = document.getElementById("searchResults");
  if (res.length === 0) { div.style.display="none"; return; }
  div.innerHTML = res.map((r,i) =>
    `<div class="sri" onclick="(${JSON.stringify(r)},searchIndex.find(x=>x.label===this.dataset.label&&x.type===this.dataset.type)?.action())" data-idx="${i}">
      <div class="sl">${r.label.replace(new RegExp(q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'),"gi"),m=>`<mark>${m}</mark>`)}</div>
      <div class="ss">${r.type} · ${r.sub}</div>
    </div>`).join("");
  // Attach click handlers after render to avoid inline-eval issues
  div.querySelectorAll(".sri").forEach((el,i) => {
    el.addEventListener("click", () => { res[i].action(); div.style.display="none"; });
  });
  div.style.display = "block";
}

