// ── Inline Gantt Bar ──
function renderGanttBar(l) {
  // Non-LOA modalities: show plain date range only
  if (l.modality !== 'loa') {
    return `<span style="font-size:11px;color:var(--gray3);">${l.start||'—'} → ${l.end||'—'}</span>`;
  }
  // Parse a date string (many formats) to a JS Date
  function pd(s) {
    if (!s || s === '—') return null;
    // Common formats: "01 Aug 2024", "Aug 2024", "2024", "30 Jun 2026", "23 Oct 2025"
    const months = {Jan:0,Feb:1,Mar:2,Apr:3,May:4,Jun:5,Jul:6,Aug:7,Sep:8,Oct:9,Nov:10,Dec:11};
    s = s.trim();
    // DD Mon YYYY
    let m = s.match(/^(\d{1,2})\s+([A-Za-z]{3})\s+(\d{4})$/);
    if (m) return new Date(+m[3], months[m[2]], +m[1]);
    // Mon YYYY
    m = s.match(/^([A-Za-z]{3})\s+(\d{4})$/);
    if (m) return new Date(+m[2], months[m[1]], 1);
    // YYYY
    m = s.match(/^(\d{4})$/);
    if (m) return new Date(+m[1], 0, 1);
    // DD-Mon-YYYY
    m = s.match(/^(\d{1,2})-([A-Za-z]{3})-(\d{4})$/);
    if (m) return new Date(+m[3], months[m[2]], +m[1]);
    return new Date(s);
  }

  const start = pd(l.start);
  const end   = pd(l.end);
  if (!start || !end || isNaN(start) || isNaN(end)) {
    return `<span style="font-size:11px;color:var(--gray3);">${l.start||'—'} → ${l.end||'—'}</span>`;
  }

  const today_gantt = new Date(today); // use live today from computed vars
  // Expand view range: 1 month before start to 1 month after end
  const viewStart = new Date(start); viewStart.setMonth(viewStart.getMonth() - 1);
  const viewEnd   = new Date(end);   viewEnd.setMonth(viewEnd.getMonth() + 1);
  const span = viewEnd - viewStart;

  function pct(d) {
    return Math.max(0, Math.min(100, ((d - viewStart) / span) * 100));
  }

  const barLeft = pct(start);
  const barRight = pct(end);
  const barW = barRight - barLeft;

  // Bar color by status
  const barColors = {
    Active:'var(--blue)',Operational:'var(--green)',Completed:'var(--teal)',
    Expired:'var(--red)',Overdue:'var(--red)','Closed (Completed)':'var(--teal)',
    'Under Development':'var(--amber)','Under Review':'var(--blue-mid)',
    'To be Developed':'var(--gray3)','Not Started':'var(--gray3)',
    'On Order':'var(--teal)','Delivered':'var(--green)','Under Evaluation':'var(--amber)'
  };
  const barColor = barColors[l.status] || 'var(--blue-mid)';

  // Today marker (only if within view range)
  let todayHtml = '';
  if (today_gantt >= viewStart && today_gantt <= viewEnd) {
    const todayFmt = today_gantt.toLocaleDateString("en-GB",{day:"numeric",month:"short",year:"numeric"});
    todayHtml = `<div class="gantt-today" style="left:${pct(today_gantt)}%;" title="Today: ${todayFmt}"></div>`;
  }

  // Workplan pips
  let pipsHtml = '';
  if (l.workplan && l.workplan.length) {
    l.workplan.forEach(wp => {
      const d = pd(wp.date);
      if (!d || isNaN(d)) return;
      const p = pct(d);
      let pip_color, pip_title;
      if (wp.type === 'report') {
        const rColors = {Submitted:'var(--green)',Overdue:'var(--red)',Pending:'var(--amber)'};
        pip_color = rColors[wp.status] || 'var(--amber)';
        pip_title = `📋 ${wp.label} (${wp.status||''})`;
      } else {
        pip_color = 'var(--blue)';
        pip_title = `◆ ${wp.label}`;
      }
      pipsHtml += `<div class="gantt-pip" style="left:${p}%;background:${pip_color};" title="${pip_title.replace(/"/g,'&quot;')}"></div>`;
    });
  }

  // Short date labels
  function fmtShort(d) {
    const mo = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    return mo[d.getMonth()] + ' ' + String(d.getFullYear()).slice(2);
  }

  return `<div class="gantt-wrap">
    <div class="gantt-dates"><span>${fmtShort(start)}</span><span>${fmtShort(end)}</span></div>
    <div class="gantt-track">
      <div class="gantt-bar" style="left:${barLeft}%;width:${barW}%;background:${barColor};"></div>
      ${todayHtml}
      ${pipsHtml}
    </div>
  </div>`;
}

