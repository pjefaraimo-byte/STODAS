/* ── ALERTS TAB ── */
function renderMpAlerts() {
  const container = document.getElementById("mpAlertsList");
  if (!container) return;
  let html = "";

  // Delayed activities
  const delayed = mpCurrentActivities.filter(a => {
    const hist = progressDB[a.id];
    const status = hist&&hist.length ? hist[hist.length-1].status : mapIntStatus(a.status);
    return status === "Delayed" || status === "At Risk";
  });
  if (delayed.length) {
    html += `<div style="font-size:12px;font-weight:700;color:var(--red);margin-bottom:8px;text-transform:uppercase;letter-spacing:.5px;">🔴 Delayed / At-Risk Activities (${delayed.length})</div>`;
    delayed.forEach(a => {
      const hist = progressDB[a.id]||[];
      const lat = hist.length ? hist[hist.length-1] : null;
      html += `<div class="alert-card">
        <div>
          <div style="font-weight:700;">${a.id} — ${a.name}</div>
          <div style="color:var(--gray3);margin-top:3px;">Focal: ${a.focal||"—"} · End: ${a.end||"TBD"}</div>
          ${lat?.challenges?`<div style="margin-top:5px;"><strong>Last reported issue:</strong> ${lat.challenges}</div>`:""}
          ${lat?.mitigation?`<div style="margin-top:3px;"><strong>Mitigation:</strong> ${lat.mitigation}</div>`:""}
        </div>
      </div>`;
    });
  }

  // Activities with no updates
  const noUpdates = mpCurrentActivities.filter(a => !(progressDB[a.id]||[]).length && a.status !== "Cancelled");
  if (noUpdates.length) {
    html += `<div style="font-size:12px;font-weight:700;color:var(--amber);margin-top:16px;margin-bottom:8px;text-transform:uppercase;letter-spacing:.5px;">⚠ Activities With No Progress Updates (${noUpdates.length})</div>`;
    noUpdates.forEach(a => {
      html += `<div class="deadline-card">
        <div>
          <div style="font-weight:700;">${a.id} — ${a.name}</div>
          <div style="color:var(--gray3);margin-top:3px;">Status: ${a.status} · Focal: ${a.focal||"—"}</div>
        </div>
      </div>`;
    });
  }

  // Activities nearing end date
  const now = new Date();
  const approaching = mpCurrentActivities.filter(a => {
    if (!a.end || a.end === "TBD" || a.status === "Completed" || a.status === "Cancelled") return false;
    const endParts = a.end.split(" ");
    if (endParts.length < 2) return false;
    try {
      const end = new Date(a.end);
      const daysLeft = (end - now) / (1000*60*60*24);
      return daysLeft > 0 && daysLeft < 90;
    } catch(e) { return false; }
  });
  if (approaching.length) {
    html += `<div style="font-size:12px;font-weight:700;color:var(--blue);margin-top:16px;margin-bottom:8px;text-transform:uppercase;letter-spacing:.5px;">📅 Upcoming Deadlines — Next 90 Days (${approaching.length})</div>`;
    approaching.forEach(a => {
      html += `<div class="deadline-card" style="background:var(--blue-light);border-left-color:var(--blue);">
        <div><div style="font-weight:700;">${a.id} — ${a.name}</div><div style="color:var(--gray3);margin-top:3px;">End: ${a.end} · Focal: ${a.focal||"—"}</div></div>
      </div>`;
    });
  }

  if (!html) html = `<div class="no-updates"><div style="font-size:32px;margin-bottom:10px;">✅</div><div style="font-size:14px;font-weight:700;margin-bottom:5px;color:var(--gray4);">No Alerts</div><div>All activities are progressing normally.</div></div>`;
  container.innerHTML = html;
}

