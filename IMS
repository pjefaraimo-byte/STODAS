      // Build a merged workplan from LOA_WORKPLANS (authoritative status)
      const merged = [
        ...(wp.milestones||[]).map(m=>({date:m.date,label:m.label,type:"milestone",status:m.status})),
        ...(wp.reports||[]).map(r=>({date:r.date,label:r.label,type:"report",status:r.status})),
        ...(wp.deliverables||[]).map(d=>({date:d.date,label:d.label,type:"deliverable",status:d.status})),
      ];
      if (merged.length) {
        // Sort by date
        merged.sort((a,b) => new Date(a.date||0) - new Date(b.date||0));
        l.workplan = merged;
      }
    });
