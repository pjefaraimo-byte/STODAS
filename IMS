function openRFEdit(idx) {
  const r = APP_DATA.rfData[idx];
  if (!r) return;
  document.getElementById("rfEditIdx").value = idx;
  document.getElementById("rfEditTitle").textContent = r.indicator;
  document.getElementById("rfEditBaseline").textContent = r.baseline;
  document.getElementById("rfEditTarget").textContent = r.totalTarget;
  document.getElementById("re_y1").value = r.y1prog||"";
  document.getElementById("re_y2").value = r.prog2025||r.prog2024||"";
  document.getElementById("re_y3").value = r.y3prog||"";
  document.getElementById("re_y4").value = r.y4prog||"";
  document.getElementById("re_cum").value = r.cumulative||"";
  document.getElementById("re_pct").value = r.pct!=null?r.pct:"";
  document.getElementById("re_comments").value = r.comments||"";
  document.getElementById("rfEditOverlay").style.display = "block";
}
function closeRFEdit() {
  document.getElementById("rfEditOverlay").style.display = "none";
}
function saveRFEdit() {
  const idx = parseInt(document.getElementById("rfEditIdx").value);
  const r = APP_DATA.rfData[idx];
  if (!r) return;
  r.y1prog    = document.getElementById("re_y1").value.trim()||"—";
  r.prog2025  = document.getElementById("re_y2").value.trim()||"—";
  r.prog2024  = r.prog2025;
  r.y3prog    = document.getElementById("re_y3").value.trim()||"—";
  r.y4prog    = document.getElementById("re_y4").value.trim()||"—";
  r.cumulative= document.getElementById("re_cum").value.trim()||r.cumulative;
  const pv    = parseFloat(document.getElementById("re_pct").value);
  r.pct       = isNaN(pv)?null:Math.min(100,Math.max(0,pv));
  r.comments  = document.getElementById("re_comments").value.trim()||r.comments;
  closeRFEdit();
  renderRF(document.querySelector(".rff.active")?.textContent?.trim()==="All"?"all":
           document.querySelector(".rff.active")?.textContent?.trim()||"all");
  renderRFGauges();
}
function filterRF(v) {
  document.querySelectorAll(".rff").forEach(b => {
    const map={"all":"All","Impact":"Impact","Outcome":"Outcome","Output 1":"Output 1","Output 2":"Output 2","Output 3":"Output 3","behind":"🔴 Behind Target"};
    b.classList.toggle("active", b.textContent.trim()===map[v]);
  });
  renderRF(v);
}

