.login-title{text-align:center;font-size:20px;font-weight:700;color:var(--blue-dark);margin-bottom:4px;}
.login-sub{text-align:center;font-size:12px;color:var(--gray3);margin-bottom:28px;}
.login-field{margin-bottom:16px;}
.login-field label{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--gray3);margin-bottom:6px;}
.login-field input{width:100%;border:1.5px solid var(--gray2);border-radius:9px;padding:12px 14px;font-size:14px;font-family:var(--font);color:var(--gray4);outline:none;transition:border-color .2s;}
.login-field input:focus{border-color:var(--blue);}
.login-error{background:var(--red-light);color:var(--red);border-radius:7px;padding:9px 13px;font-size:12px;font-weight:600;margin-bottom:14px;display:none;}
.login-btn{width:100%;background:linear-gradient(135deg,var(--blue-dark),var(--blue));color:white;border:none;border-radius:9px;padding:13px;font-size:14px;font-weight:700;font-family:var(--font);cursor:pointer;transition:opacity .2s;margin-top:4px;}
.login-btn:hover{opacity:.88;}
.login-footer{text-align:center;font-size:11px;color:var(--gray3);margin-top:20px;}
.user-chip{background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.3);border-radius:20px;padding:4px 12px;font-size:11px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:5px;}
.user-chip:hover{background:rgba(255,255,255,.28);}

/* ══════════════════════════════════════
   SURVEY DATA ENTRY FORM
   ══════════════════════════════════════ */
.survey-form{max-width:780px;margin:0 auto;}
.sf-section{background:white;border-radius:var(--radius);box-shadow:var(--shadow);margin-bottom:14px;overflow:hidden;}
.sf-section-header{background:linear-gradient(135deg,var(--blue-dark),var(--blue));color:white;padding:12px 18px;display:flex;align-items:center;gap:10px;cursor:pointer;user-select:none;}
.sf-section-header .sf-icon{font-size:18px;}
.sf-section-header .sf-title{font-size:13px;font-weight:700;}
.sf-section-header .sf-badge{background:rgba(255,255,255,.2);border-radius:10px;padding:2px 8px;font-size:10px;font-weight:600;margin-left:auto;}
.sf-section-header .sf-chevron{transition:transform .25s;margin-left:6px;}
.sf-section-header.collapsed .sf-chevron{transform:rotate(-90deg);}
.sf-body{padding:18px 20px;border-top:1px solid var(--gray2);}
.sf-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;}
.sf-row.full{grid-template-columns:1fr;}
.sf-row.three{grid-template-columns:1fr 1fr 1fr;}
.sf-field{display:flex;flex-direction:column;gap:5px;}
.sf-field label{font-size:11px;font-weight:700;color:var(--gray3);text-transform:uppercase;letter-spacing:.4px;}
.sf-field label .req{color:var(--red);margin-left:2px;}
.sf-field input,.sf-field select,.sf-field textarea{border:1.5px solid var(--gray2);border-radius:8px;padding:9px 12px;font-size:13px;font-family:var(--font);color:var(--gray4);outline:none;transition:border-color .2s;background:white;}
.sf-field input:focus,.sf-field select:focus,.sf-field textarea:focus{border-color:var(--blue);}
.sf-field textarea{resize:vertical;min-height:70px;}
.sf-check-group{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px;}
.sf-check{display:flex;align-items:center;gap:6px;background:var(--gray);border-radius:6px;padding:6px 10px;cursor:pointer;transition:background .15s;font-size:12px;border:1.5px solid transparent;}
.sf-check input[type=checkbox]{accent-color:var(--blue);width:14px;height:14px;cursor:pointer;}
.sf-check:has(input:checked){background:var(--blue-light);border-color:var(--blue);color:var(--blue);font-weight:600;}
.sf-radio-group{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px;}
.sf-radio{display:flex;align-items:center;gap:6px;background:var(--gray);border-radius:6px;padding:7px 12px;cursor:pointer;transition:background .15s;font-size:12px;border:1.5px solid transparent;}
.sf-radio input[type=radio]{accent-color:var(--blue);width:14px;height:14px;cursor:pointer;}
.sf-radio:has(input:checked){background:var(--blue-light);border-color:var(--blue);color:var(--blue);font-weight:600;}
.sf-fies-item{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-radius:8px;background:var(--gray);margin-bottom:8px;gap:12px;flex-wrap:wrap;}
.sf-fies-q{font-size:12px;font-weight:500;color:var(--gray4);flex:1;min-width:200px;}
.sf-fies-toggle{display:flex;gap:6px;flex-shrink:0;}
.sf-fies-btn{border:1.5px solid var(--gray2);background:white;border-radius:6px;padding:5px 14px;font-size:11px;font-weight:700;font-family:var(--font);cursor:pointer;transition:all .15s;}
.sf-fies-btn.yes.active{background:var(--red-light);border-color:var(--red);color:var(--red);}
.sf-fies-btn.no.active{background:var(--green-light);border-color:var(--green);color:var(--green);}
.sf-crop-table{width:100%;border-collapse:collapse;font-size:12px;}
.sf-crop-table th{background:var(--blue);color:white;padding:8px 10px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;}
.sf-crop-table td{padding:6px 8px;border-bottom:1px solid var(--gray2);}
.sf-crop-table td input,.sf-crop-table td select{border:1px solid var(--gray2);border-radius:5px;padding:5px 8px;font-size:12px;font-family:var(--font);width:100%;outline:none;}
.sf-crop-table td input:focus,.sf-crop-table td select:focus{border-color:var(--blue);}
.sf-actions{display:flex;gap:10px;justify-content:flex-end;padding:14px 20px;background:var(--gray);border-top:1px solid var(--gray2);}
.sf-nav{display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap;}
.sf-nav-btn{padding:7px 16px;border-radius:20px;border:1.5px solid var(--gray2);background:white;font-size:11px;font-weight:700;font-family:var(--font);cursor:pointer;transition:all .15s;color:var(--gray3);}
.sf-nav-btn:hover,.sf-nav-btn.active{background:var(--blue);color:white;border-color:var(--blue);}
.sf-progress{background:var(--gray2);border-radius:4px;height:5px;margin-bottom:16px;overflow:hidden;}
.sf-progress-fill{height:100%;background:linear-gradient(90deg,var(--blue),var(--blue-mid));border-radius:4px;transition:width .5s ease;}
.hh-record{background:white;border-radius:8px;box-shadow:var(--shadow);padding:14px 16px;margin-bottom:10px;display:flex;align-items:center;gap:12px;cursor:pointer;transition:box-shadow .15s;}
.hh-record:hover{box-shadow:var(--shadow-lg);}
.hh-id{background:var(--blue);color:white;border-radius:6px;padding:3px 9px;font-size:11px;font-weight:700;white-space:nowrap;font-family:var(--mono);}
.hh-info{flex:1;}
.hh-name{font-size:13px;font-weight:700;color:var(--gray4);}
.hh-meta{font-size:11px;color:var(--gray3);margin-top:2px;}
.empty-state{text-align:center;padding:40px 20px;color:var(--gray3);}
.empty-state .es-icon{font-size:36px;margin-bottom:10px;}
.empty-state .es-title{font-size:14px;font-weight:700;margin-bottom:5px;color:var(--gray4);}
.empty-state .es-sub{font-size:12px;}

