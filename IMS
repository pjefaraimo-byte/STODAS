// In-memory file store: key = folderId, value = array of {name,size,type,date,dataUrl}
const DM_FILES = {};
let dmSelectedFolder = null;
const dmExpanded = new Set();

function dmFolderId(country, output, activity) {
  return [country, output, activity].filter(Boolean).join("||");
}

function dmGetFiles(folderId) {
  return DM_FILES[folderId] || [];
}

function dmGetIntervention(id) {
  const all = getAllInterventions();
  return all.find(i => i.id === id);
}

function dmStatusIcon(id) {
  const int = dmGetIntervention(id);
  if (!int) return "";
  const s = int.status;
  if (s==="Completed On Time"||s==="Completed") return "✅";
  if (s==="On Track") return "🟢";
  if (s==="At Risk") return "🟡";
  if (s==="Not Started") return "⬜";
  if (s==="Cancelled") return "🚫";
  if (s==="Delayed") return "🟠";
  return "⬜";
}

function dmRenderTree(filterText) {
  const tree = document.getElementById("dmTree");
  if (!tree) return;
  const ft = (filterText||"").toLowerCase();

  let html = "";
  Object.entries(DM_TREE).forEach(([countryKey, country]) => {
    const countryId = dmFolderId(countryKey);
    const cOpen = dmExpanded.has(countryId);
    const cFiles = dmGetFiles(countryId);
    const cFileCount = cFiles.length;
    const cMatch = !ft || country.label.toLowerCase().includes(ft);

    // Total files in country
    let totalFiles = cFileCount;
    Object.entries(country.outputs).forEach(([outKey, output]) => {
      const outId = dmFolderId(countryKey, outKey);
      totalFiles += dmGetFiles(outId).length;
      Object.entries(output.activities).forEach(([actKey, ids]) => {
        totalFiles += dmGetFiles(dmFolderId(countryKey, outKey, actKey)).length;
      });
    });

    html += `<div class="dm-country" data-id="${countryId}">
      <div class="dm-node dm-country-node${cOpen?" open":""}" onclick="dmToggle('${countryId}',event)">
        <span class="dm-arrow">${cOpen?"▾":"▸"}</span>
        <span style="font-size:16px;margin-right:5px;">${country.flag}</span>
        <span style="font-weight:700;flex:1;">${country.label.replace(country.flag,"").trim()}</span>
        ${totalFiles>0?`<span class="dm-badge">${totalFiles}</span>`:""}
        <button class="dm-upload-btn" onclick="dmSelectFolder('${countryId}','${country.label}',event)" title="Open folder">📂</button>
      </div>`;

    if (cOpen) {
      Object.entries(country.outputs).forEach(([outKey, output]) => {
        const outId = dmFolderId(countryKey, outKey);
        const oOpen = dmExpanded.has(outId);
        const oFiles = dmGetFiles(outId).length;
        let oTotal = oFiles;
        Object.entries(output.activities).forEach(([actKey]) => {
          oTotal += dmGetFiles(dmFolderId(countryKey, outKey, actKey)).length;
        });

        html += `<div class="dm-output" data-id="${outId}" style="margin-left:14px;">
          <div class="dm-node dm-output-node${oOpen?" open":""}" onclick="dmToggle('${outId}',event)">
            <span class="dm-arrow">${oOpen?"▾":"▸"}</span>
            <span style="font-size:13px;margin-right:5px;">📁</span>
            <span style="font-weight:600;flex:1;font-size:11.5px;">${outKey} — ${output.label.replace(/Output \d — /,"")}</span>
            ${oTotal>0?`<span class="dm-badge">${oTotal}</span>`:""}
            <button class="dm-upload-btn" onclick="dmSelectFolder('${outId}','${output.label}',event)" title="Open folder">📂</button>
          </div>`;

        if (oOpen) {
          Object.entries(output.activities).forEach(([actKey, ids]) => {
            const actId = dmFolderId(countryKey, outKey, actKey);
            const aFiles = dmGetFiles(actId).length;
            html += `<div style="margin-left:14px;">
              <div class="dm-node dm-act-node${dmSelectedFolder===actId?" selected":""}" onclick="dmSelectFolder('${actId}','${actKey}',event)">
                <span style="font-size:12px;margin-right:5px;">📄</span>
                <span style="flex:1;font-size:11px;">${actKey}</span>
                ${aFiles>0?`<span class="dm-badge">${aFiles}</span>`:""}
                <button class="dm-upload-btn" onclick="dmSelectFolder('${actId}','${actKey}',event)" title="Open folder">📂</button>
              </div>
            </div>`;
          });
        }
        html += `</div>`;
      });
    }
    html += `</div>`;
  });
  tree.innerHTML = html;
}

function dmToggle(id, e) {
  if (e) e.stopPropagation();
  if (dmExpanded.has(id)) dmExpanded.delete(id);
  else dmExpanded.add(id);
  dmRenderTree();
}

function dmSelectFolder(id, label, e) {
  if (e) e.stopPropagation();
  dmSelectedFolder = id;
  dmExpanded.add(id);
  // Also expand parents
  const parts = id.split("||");
  if (parts.length >= 2) dmExpanded.add(parts[0]);
  if (parts.length >= 3) dmExpanded.add(parts.slice(0,2).join("||"));
  dmRenderTree();
  dmRenderPanel(id, label);
}

function dmRenderPanel(folderId, label) {
  const header = document.getElementById("dmPanelHeader");
  const body = document.getElementById("dmPanelBody");
  if (!header || !body) return;

  header.innerHTML = `<div style="display:flex;justify-content:space-between;align-items:center;">
    <span>📂 ${label}</span>
    <label style="background:var(--blue);color:white;border-radius:6px;padding:7px 14px;font-size:11px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:5px;">
      ⬆ Upload File
      <input type="file" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.png,.mp4" style="display:none;" onchange="dmHandleUpload('${folderId}','${label}',this)"/>
    </label>
  </div>`;

  const files = dmGetFiles(folderId);

  // Sub-activities list (if activity folder)
  const parts = folderId.split("||");
  let actSection = "";
  if (parts.length === 3) {
    const [countryKey, outKey, actKey] = parts;
    const ids = DM_TREE[countryKey]?.outputs[outKey]?.activities[actKey]||[];
    if (ids.length) {
      actSection = `<div style="margin-bottom:16px;">
        <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--gray3);margin-bottom:8px;">Sub-Activities in this folder</div>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          ${ids.map(id => {
            const int = dmGetIntervention(id);
            const statusIcon = dmStatusIcon(id);
            return `<span style="background:var(--gray);border-radius:5px;padding:4px 8px;font-size:10px;display:flex;align-items:center;gap:4px;" title="${int?int.name:id}">
              ${statusIcon} <strong>${id}</strong>${int?` — ${int.name.slice(0,30)}…`:""}
            </span>`;
          }).join("")}
        </div>
      </div>`;
    }
  }

  if (!files.length) {
    body.innerHTML = actSection + `<div style="text-align:center;padding:50px 20px;color:var(--gray3);border:2px dashed var(--gray2);border-radius:10px;cursor:pointer;"
        onclick="this.querySelector('input').click()"
        ondragover="event.preventDefault();this.style.borderColor='var(--blue)'"
        ondragleave="this.style.borderColor='var(--gray2)'"
        ondrop="dmHandleDrop('${folderId}','${label}',event);this.style.borderColor='var(--gray2)'">
      <div style="font-size:36px;margin-bottom:10px;">📎</div>
      <div style="font-size:13px;font-weight:600;">Drop files here or click to upload</div>
      <div style="font-size:11px;margin-top:5px;">PDF, Word, Excel, PowerPoint, images supported</div>
      <input type="file" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.png,.mp4" style="display:none;" onchange="dmHandleUpload('${folderId}','${label}',this)"/>
    </div>`;
    return;
  }

  const fileRows = files.map((f, fi) => {
    const ext = f.name.split(".").pop().toUpperCase();
    const icon = {PDF:"📕",DOC:"📘",DOCX:"📘",XLS:"📗",XLSX:"📗",PPT:"📙",PPTX:"📙",JPG:"🖼",PNG:"🖼",MP4:"🎬"}[ext]||"📄";
    return `<div style="display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:8px;background:var(--gray);margin-bottom:6px;">
      <span style="font-size:22px;">${icon}</span>
      <div style="flex:1;min-width:0;">
        <div style="font-weight:600;font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${f.name}</div>
        <div style="font-size:10px;color:var(--gray3);margin-top:2px;">${ext} · ${dmFmtSize(f.size)} · Uploaded ${f.date}</div>
      </div>
      <div style="display:flex;gap:6px;flex-shrink:0;">
        ${f.dataUrl?`<button onclick="dmViewFile('${folderId}',${fi})" style="background:var(--blue-light);color:var(--blue);border:1px solid var(--blue-mid);border-radius:5px;padding:5px 10px;font-size:10px;font-weight:600;cursor:pointer;">👁 View</button>`:""}
        <button onclick="dmDeleteFile('${folderId}',${fi})" style="background:#FEE;color:var(--red);border:1px solid #FFBBBB;border-radius:5px;padding:5px 10px;font-size:10px;font-weight:600;cursor:pointer;">🗑 Remove</button>
      </div>
    </div>`;
  }).join("");

  body.innerHTML = actSection +
    `<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
      <div style="font-size:11px;color:var(--gray3);">${files.length} file${files.length!==1?"s":""} in this folder</div>
      <label style="font-size:11px;color:var(--blue);cursor:pointer;font-weight:600;">
        ➕ Add more files
        <input type="file" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.png,.mp4" style="display:none;" onchange="dmHandleUpload('${folderId}','${label}',this)"/>
      </label>
    </div>` + fileRows;
}

function dmHandleUpload(folderId, label, input) {
  const files = Array.from(input.files);
  if (!files.length) return;
  if (!DM_FILES[folderId]) DM_FILES[folderId] = [];
  const today = new Date().toLocaleDateString("en-GB",{day:"2-digit",month:"short",year:"numeric"});
  let pending = files.length;
  files.forEach(file => {
    const reader = new FileReader();
    reader.onload = e => {
      DM_FILES[folderId].push({name:file.name, size:file.size, type:file.type, date:today, dataUrl:e.target.result});
      pending--;
      if (pending===0) { dmRenderTree(); dmRenderPanel(folderId, label); }
    };
    reader.readAsDataURL(file);
  });
}

function dmHandleDrop(folderId, label, e) {
  e.preventDefault();
  const input = {files: e.dataTransfer.files};
  dmHandleUpload(folderId, label, input);
}

function dmDeleteFile(folderId, idx) {
  if (!DM_FILES[folderId]) return;
  const label = document.getElementById("dmPanelHeader")?.querySelector("span")?.textContent?.replace("📂 ","");
  DM_FILES[folderId].splice(idx, 1);
  dmRenderTree();
  dmRenderPanel(folderId, label||"");
}

function dmViewFile(folderId, idx) {
  const f = (DM_FILES[folderId]||[])[idx];
  if (!f) return;
  const overlay = document.getElementById("dmViewerOverlay");
  document.getElementById("dmViewerTitle").textContent = `📄 ${f.name}`;
  const body = document.getElementById("dmViewerBody");
  const ext = f.name.split(".").pop().toLowerCase();
  if (["jpg","jpeg","png","gif","webp"].includes(ext)) {
    body.innerHTML = `<img src="${f.dataUrl}" style="max-width:100%;border-radius:8px;"/>`;
  } else if (ext==="pdf") {
    body.innerHTML = `<iframe src="${f.dataUrl}" style="width:100%;height:65vh;border:none;border-radius:8px;"></iframe>`;
  } else {
    body.innerHTML = `<div style="text-align:center;padding:40px;">
      <div style="font-size:48px;margin-bottom:16px;">📄</div>
      <div style="font-size:14px;font-weight:600;margin-bottom:8px;">${f.name}</div>
      <div style="font-size:12px;color:var(--gray3);margin-bottom:20px;">${dmFmtSize(f.size)} · ${f.type||ext.toUpperCase()}</div>
      <a href="${f.dataUrl}" download="${f.name}" style="background:var(--blue);color:white;border-radius:7px;padding:10px 22px;text-decoration:none;font-size:13px;font-weight:600;">⬇ Download File</a>
    </div>`;
  }
  overlay.style.display = "block";
}

function closeDMViewer() {
  document.getElementById("dmViewerOverlay").style.display = "none";
}

function dmFmtSize(bytes) {
  if (!bytes) return "—";
  if (bytes < 1024) return bytes + " B";
  if (bytes < 1048576) return (bytes/1024).toFixed(1) + " KB";
  return (bytes/1048576).toFixed(1) + " MB";
}

function dmFilter(text) { dmRenderTree(text); }

function dmExpandAll() {
  Object.keys(DM_TREE).forEach(c => {
    dmExpanded.add(c);
    Object.keys(DM_TREE[c].outputs).forEach(o => {
      dmExpanded.add(dmFolderId(c,o));
    });
  });
  dmRenderTree();
}

function dmCollapseAll() {
  dmExpanded.clear();
  dmRenderTree();
}

