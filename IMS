.toast{position:fixed;bottom:24px;right:24px;background:var(--gray4);color:white;border-radius:10px;padding:12px 20px;font-size:12px;font-weight:600;z-index:9999;opacity:0;transform:translateY(10px);transition:all .3s;pointer-events:none;}
