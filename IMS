// Today and project timing
const today = new Date();
const projectStart = APP_DATA.settings.projectStart;
const projectEnd   = APP_DATA.settings.projectEnd;
const daysElapsed  = Math.floor((today - projectStart) / 86400000);
const daysLeft     = Math.max(0, Math.floor((projectEnd - today) / 86400000));
const totalDays    = Math.floor((projectEnd - projectStart) / 86400000);
const pctElapsed   = Math.min(100, (daysElapsed / totalDays * 100)).toFixed(1);
const cashBalance  = APP_DATA.settings.totalBudget - APP_DATA.settings.totalActuals - APP_DATA.settings.hardCommits;
const dailyNeeded  = daysLeft > 0 ? cashBalance / daysLeft : 0;
const dailyActual  = APP_DATA.settings.totalActuals / daysElapsed;
const rateMultiple = dailyActual > 0 ? (dailyNeeded / dailyActual).toFixed(1) : "∞";

function fmtUSD(n) {
  if (n === undefined || n === null) return "—";
  const abs = Math.abs(n);
  const sign = n < 0 ? "-" : "";
  if (abs >= 1e6) return sign + "$" + (abs/1e6).toFixed(2) + "M";
  if (abs >= 1e3) return sign + "$" + abs.toLocaleString();
  return sign + "$" + abs;
}
function fmtUSDFull(n) {
  if (!n && n !== 0) return "—";
  return (n < 0 ? "-$" : "$") + Math.abs(n).toLocaleString();
}
function fmtPct(n) { return n.toFixed(1) + "%"; }
function todayStr() {
  return today.toLocaleDateString("en-US",{day:"numeric",month:"long",year:"numeric"});
}

