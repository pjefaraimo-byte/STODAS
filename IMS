// ── Budget Drilldown ──
function budgetFlag(r) {
  const bal = r.bal !== undefined ? r.bal : (r.total - r.actual - r.hard);
  if (r.actual > r.total) return `<span class="flag red">Over Budget</span>`;
  const pct = r.total > 0 ? r.actual/r.total*100 : 0;
  if (pct >= 60) return `<span class="flag green">✓ Good</span>`;
  if (pct >= 25) return `<span class="flag amber">⚠ Monitor</span>`;
  return `<span class="flag red">🔴 Low</span>`;
}
