<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>STODAS Dashboard v3</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>
/* ═══════════════════════════════════════════════════
   STODAS DASHBOARD v3  —  STATIC UI / DESIGN LAYER
   Dynamic data sections marked with /* DATA */
   ═══════════════════════════════════════════════════ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --blue:#1B4F9B;--blue-light:#E8F0FB;--blue-mid:#3B7DD8;--blue-dark:#0F2D5E;
  --teal:#0F7B6C;--teal-light:#E0F4F1;
  --amber:#C47A15;--amber-light:#FDF3E0;
  --red:#B83232;--red-light:#FDECEC;
  --green:#2E7D32;--green-light:#E8F5E9;
  --purple:#512DA8;--purple-light:#EDE7F6;
  --gray:#F5F6FA;--gray2:#E8EAF0;--gray3:#9399A8;--gray4:#3C4057;
  --white:#fff;
  --shadow:0 1px 4px rgba(0,0,0,.08),0 0 0 1px rgba(0,0,0,.04);
  --shadow-lg:0 8px 32px rgba(0,0,0,.12);
  --font:'IBM Plex Sans',sans-serif;--mono:'IBM Plex Mono',monospace;
  --radius:10px;
}
body{font-family:var(--font);background:#EEF0F8;color:var(--gray4);font-size:14px;line-height:1.5;}
/* ── TOPBAR ── */
.topbar{background:linear-gradient(135deg,var(--blue-dark) 0%,var(--blue) 60%,var(--blue-mid) 100%);color:white;padding:13px 24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;position:sticky;top:0;z-index:400;}
.topbar-brand{display:flex;align-items:center;gap:12px;}
.topbar-logo{width:36px;height:36px;background:rgba(255,255,255,.18);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:18px;border:1px solid rgba(255,255,255,.25);}
.topbar h1{font-size:16px;font-weight:700;letter-spacing:-.3px;}
.topbar .sub{font-size:10px;opacity:.75;margin-top:1px;}
.topbar-right{display:flex;gap:7px;align-items:center;flex-wrap:wrap;}
.badge{background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);border-radius:20px;padding:3px 10px;font-size:10px;font-weight:600;white-space:nowrap;}
.badge.green{background:rgba(46,125,50,.8);border-color:#4CAF50;}
.badge.red{background:rgba(184,50,50,.8);border-color:#e05555;}
.badge.amber{background:rgba(196,122,21,.8);border-color:#f0a030;}
/* ── TOOLBAR ── */
.toolbar{background:white;border-bottom:2px solid var(--gray2);padding:8px 24px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.toolbar-search{position:relative;flex:1;min-width:220px;max-width:380px;}
.toolbar-search input{width:100%;border:1.5px solid var(--gray2);border-radius:20px;padding:7px 14px 7px 36px;font-size:12px;font-family:var(--font);outline:none;color:var(--gray4);transition:border-color .2s;}
.toolbar-search input:focus{border-color:var(--blue);}
.toolbar-search .search-icon{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--gray3);font-size:13px;pointer-events:none;}
#searchResults{display:none;position:absolute;top:38px;left:0;background:white;border:1px solid var(--gray2);border-radius:10px;width:100%;max-height:280px;overflow-y:auto;z-index:500;box-shadow:var(--shadow-lg);}
.sri{padding:10px 14px;cursor:pointer;border-bottom:1px solid var(--gray2);font-size:12px;}
.sri:hover{background:var(--gray);}
.sri .sl{font-weight:600;color:var(--gray4);}
.sri .ss{color:var(--gray3);font-size:11px;margin-top:1px;}
.sri mark{background:#FFF3CD;border-radius:2px;padding:0 2px;}
/* Filter chips */
.filter-chips{display:flex;gap:6px;flex-wrap:wrap;align-items:center;}
.filter-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--gray3);}
.fc{padding:4px 12px;border-radius:20px;border:1.5px solid var(--gray2);background:white;color:var(--gray3);font-size:11px;font-weight:600;cursor:pointer;font-family:var(--font);transition:all .15s;display:flex;align-items:center;gap:4px;}
.fc:hover{border-color:var(--blue);color:var(--blue);}
.fc.active{background:var(--blue);color:white;border-color:var(--blue);}
.fc.regional{border-color:var(--purple);color:var(--purple);}
.fc.regional.active{background:var(--purple);color:white;}
/* Upload button */
.upload-btn{background:var(--teal);color:white;border:none;border-radius:7px;padding:7px 14px;font-size:11px;font-weight:600;font-family:var(--font);cursor:pointer;display:flex;align-items:center;gap:5px;white-space:nowrap;transition:opacity .15s;}
.upload-btn:hover{opacity:.85;}
.admin-toggle{background:var(--amber-light);color:var(--amber);border:1.5px solid var(--amber);border-radius:7px;padding:6px 13px;font-size:11px;font-weight:700;font-family:var(--font);cursor:pointer;display:flex;align-items:center;gap:5px;white-space:nowrap;transition:all .15s;}
.admin-toggle.active{background:var(--amber);color:white;}
/* ── TABS ── */
.tabs{background:var(--white);border-bottom:1px solid var(--gray2);padding:0 24px;display:flex;gap:0;overflow-x:auto;}
.tab{padding:11px 16px;font-size:12px;font-weight:600;color:var(--gray3);cursor:pointer;border-bottom:3px solid transparent;transition:all .15s;user-select:none;white-space:nowrap;letter-spacing:.2px;}
.tab:hover{color:var(--blue);}
.tab.active{color:var(--blue);border-bottom-color:var(--blue);background:var(--blue-light);}
/* ── PAGES ── */
.page{display:none;padding:20px 24px 60px;}
.page.active{display:block;}
/* ── KPI GRID ── */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(148px,1fr));gap:10px;margin-bottom:16px;}
.kpi{background:var(--white);border-radius:var(--radius);padding:14px 16px;box-shadow:var(--shadow);position:relative;border-left:3px solid transparent;transition:box-shadow .15s;}
.kpi:hover{box-shadow:var(--shadow-lg);}
.kpi .lbl{font-size:10px;font-weight:700;color:var(--gray3);text-transform:uppercase;letter-spacing:.6px;margin-bottom:5px;}
.kpi .val{font-size:22px;font-weight:700;color:var(--gray4);letter-spacing:-.5px;line-height:1;}
.kpi .sub{font-size:11px;color:var(--gray3);margin-top:3px;}
.kpi.blue{border-left-color:var(--blue);}.kpi.blue .val{color:var(--blue);}
.kpi.teal{border-left-color:var(--teal);}.kpi.teal .val{color:var(--teal);}
.kpi.amber{border-left-color:var(--amber);}.kpi.amber .val{color:var(--amber);}
.kpi.green{border-left-color:var(--green);}.kpi.green .val{color:var(--green);}
.kpi.red{border-left-color:var(--red);}.kpi.red .val{color:var(--red);}
.adot{position:absolute;top:12px;right:12px;width:7px;height:7px;border-radius:50%;}
.adot.red{background:var(--red);animation:pulse-red 2s infinite;}
.adot.amber{background:var(--amber);}
.adot.green{background:var(--green);}
@keyframes pulse-red{0%,100%{opacity:1;}50%{opacity:.4;}}
/* ── CARDS ── */
.card{background:var(--white);border-radius:var(--radius);box-shadow:var(--shadow);padding:16px 18px;margin-bottom:12px;}
.ct{font-size:13px;font-weight:700;color:var(--gray4);margin-bottom:12px;letter-spacing:-.2px;display:flex;align-items:center;justify-content:space-between;gap:8px;}
.ct span{font-weight:400;color:var(--gray3);font-size:11px;}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.three-col{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;}
/* ── TABLES ── */
table{width:100%;border-collapse:collapse;font-size:12px;}
th{font-size:10px;font-weight:700;color:var(--gray3);text-transform:uppercase;letter-spacing:.5px;padding:7px 10px;text-align:left;border-bottom:2px solid var(--gray2);white-space:nowrap;}
td{padding:8px 10px;border-bottom:1px solid var(--gray2);color:var(--gray4);}
tr:last-child td{border-bottom:none;}
tbody tr:hover td{background:var(--blue-light)!important;cursor:pointer;}
td.num{text-align:right;font-family:var(--mono);font-size:11px;}
td.tot{font-weight:700;color:var(--blue);}
tr.trow td{background:var(--blue-light);font-weight:700;color:var(--blue);border-top:1px solid #C5D8F5;}
.over{color:var(--red)!important;font-weight:700;}
/* ── PILLS ── */
.pill{display:inline-block;border-radius:20px;padding:2px 9px;font-size:10px;font-weight:700;white-space:nowrap;letter-spacing:.2px;}
.pill.green{background:var(--green-light);color:var(--green);}
.pill.amber{background:var(--amber-light);color:var(--amber);}
.pill.red{background:var(--red-light);color:var(--red);}
.pill.blue{background:var(--blue-light);color:var(--blue);}
.pill.gray{background:var(--gray2);color:var(--gray3);}
.pill.teal{background:var(--teal-light);color:var(--teal);}
.pill.purple{background:var(--purple-light);color:var(--purple);}
.flag{display:inline-flex;align-items:center;gap:3px;border-radius:4px;padding:2px 7px;font-size:10px;font-weight:700;}
.flag.red{background:var(--red-light);color:var(--red);}
.flag.amber{background:var(--amber-light);color:var(--amber);}
.flag.green{background:var(--green-light);color:var(--green);}
.flag.gray{background:var(--gray2);color:var(--gray3);}
/* ── PROGRESS ── */
.pw{margin:4px 0;}
.pl{display:flex;justify-content:space-between;font-size:11px;color:var(--gray3);margin-bottom:3px;}
.pt{height:7px;background:var(--gray2);border-radius:4px;overflow:hidden;}
.pf{height:100%;border-radius:4px;transition:width .8s ease;}
.pm{height:5px;background:var(--gray2);border-radius:3px;margin-top:3px;overflow:hidden;}
.pmf{height:100%;border-radius:3px;transition:width .8s ease;}
/* ── LEGEND ── */
.legend{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:9px;font-size:11px;color:var(--gray3);}
.li{display:flex;align-items:center;gap:4px;}
.ld{width:9px;height:9px;border-radius:2px;flex-shrink:0;}
/* ── BURN RATE CARD ── */
.burn-card{background:linear-gradient(135deg,#0F2D5E,#1B4F9B,#3B7DD8);border-radius:var(--radius);padding:16px 18px;color:white;margin-bottom:12px;}
.burn-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-top:10px;}
.bi .bl{font-size:10px;font-weight:700;opacity:.7;text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px;}
.bi .bv{font-size:19px;font-weight:700;}
.bi .bs{font-size:11px;opacity:.65;margin-top:1px;}
.burn-status{margin-top:10px;background:rgba(255,255,255,.12);border-radius:6px;padding:9px 13px;font-size:12px;border:1px solid rgba(255,255,255,.2);}
/* ── TIMELINE ── */
.tl-wrap{background:var(--white);border-radius:var(--radius);box-shadow:var(--shadow);padding:16px 18px;margin-bottom:12px;}
.tl-bar{position:relative;height:12px;background:var(--gray2);border-radius:6px;margin:14px 0 24px;}
.tl-fill{height:100%;border-radius:6px;background:linear-gradient(90deg,var(--blue),var(--blue-mid));}
.tl-now{position:absolute;top:-5px;width:2px;height:22px;background:var(--red);border-radius:1px;}
.tl-dates{display:flex;justify-content:space-between;font-size:10px;color:var(--gray3);margin-top:-16px;}
.ms-list{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px;}
.ms{display:inline-flex;align-items:center;gap:4px;background:var(--gray);border-radius:5px;padding:4px 9px;font-size:11px;}
.msd{width:7px;height:7px;border-radius:50%;flex-shrink:0;}
/* ── COUNTRY CARDS ── */
.cc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:12px;}
.cc{background:var(--white);border-radius:var(--radius);box-shadow:var(--shadow);padding:14px;}
.ccn{font-size:13px;font-weight:700;margin-bottom:10px;display:flex;align-items:center;gap:5px;}
.cs{display:flex;justify-content:space-between;font-size:11px;padding:4px 0;border-bottom:1px solid var(--gray2);}
.cs:last-child{border-bottom:none;}
.csl{color:var(--gray3);}
/* ── TRAFFIC LIGHTS ── */
.tg{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px;margin-bottom:14px;}
.tc{background:var(--white);border-radius:var(--radius);box-shadow:var(--shadow);padding:12px 14px;display:flex;align-items:flex-start;gap:10px;cursor:pointer;transition:box-shadow .15s;}
.tc:hover{box-shadow:var(--shadow-lg);}
.tico{font-size:20px;flex-shrink:0;line-height:1.1;}
.ticl{font-size:12px;font-weight:700;color:var(--gray4);}
.tics{font-size:11px;color:var(--gray3);margin-top:2px;line-height:1.4;}
/* ── BUTTONS ── */
.btn{border:none;border-radius:7px;padding:7px 15px;font-size:12px;font-weight:600;font-family:var(--font);cursor:pointer;display:inline-flex;align-items:center;gap:5px;transition:opacity .15s;}
.btn:hover{opacity:.85;}
.btn-blue{background:var(--blue);color:white;}
.btn-gray{background:var(--gray2);color:var(--gray4);}
.btn-green{background:var(--green);color:white;}
.btn-red{background:var(--red);color:white;}
.btn-sm{padding:4px 10px;font-size:11px;border-radius:5px;}
/* ── CAT FILTER BUTTONS ── */
.cat-btn{padding:5px 12px;border-radius:6px;border:1.5px solid var(--gray2);background:var(--white);color:var(--gray3);font-size:11px;font-weight:600;cursor:pointer;font-family:var(--font);transition:all .15s;}
.cat-btn:hover,.cat-btn.active{background:var(--blue);color:white;border-color:var(--blue);}
/* ── RF FILTERS ── */
.rff{padding:4px 13px;border-radius:20px;border:1.5px solid var(--gray2);background:var(--white);color:var(--gray3);font-size:11px;font-weight:600;cursor:pointer;font-family:var(--font);transition:all .15s;}
.rff:hover{border-color:var(--blue);color:var(--blue);}
.rff.active{background:var(--blue);color:white;border-color:var(--blue);}
/* ── LEVEL PILLS ── */
.lp{display:inline-block;border-radius:4px;padding:2px 7px;font-size:10px;font-weight:700;white-space:nowrap;}
.lp-impact{background:var(--purple-light);color:var(--purple);}
.lp-outcome{background:var(--teal-light);color:var(--teal);}
.lp-o1{background:var(--blue-light);color:var(--blue);}
.lp-o2{background:var(--amber-light);color:var(--amber);}
.lp-o3{background:var(--green-light);color:var(--green);}
/* ── INTERVENTION CARDS ── */
.int-country-card{background:var(--white);border-radius:var(--radius);box-shadow:var(--shadow);padding:14px;border:2px solid transparent;transition:all .2s;}
.int-country-card:hover{border-color:var(--blue);box-shadow:var(--shadow-lg);transform:translateY(-1px);}
.int-flag-row{display:flex;align-items:center;gap:12px;margin-bottom:8px;}
.int-click-hint{font-size:10px;color:var(--gray3);margin-top:10px;text-align:right;font-style:italic;}
/* Regional card */
.int-country-card.regional-card{background:linear-gradient(135deg,var(--purple-light),white);border-color:var(--purple);}
.int-country-card.regional-card:hover{border-color:var(--purple);box-shadow:0 6px 24px rgba(81,45,168,.15);}
/* ── DRILL-DOWN PANEL (side panel for interventions) ── */
.int-drilldown{position:fixed;top:0;right:-700px;width:min(700px,100vw);height:100vh;background:white;z-index:1100;display:flex;flex-direction:column;box-shadow:-8px 0 40px rgba(0,0,0,.2);transition:right .35s cubic-bezier(.4,0,.2,1);overflow:hidden;}
.int-drilldown.open{right:0;}
.int-dd-header{background:linear-gradient(135deg,var(--blue-dark),var(--blue));color:white;padding:18px 20px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
.int-dd-body{flex:1;overflow-y:auto;padding:18px 20px;}
.int-dd-kpi{background:var(--gray);border-radius:8px;padding:12px 14px;text-align:center;}
.int-dd-kpi-val{font-size:22px;font-weight:700;line-height:1;}
.int-dd-kpi-lbl{font-size:10px;color:var(--gray3);font-weight:600;text-transform:uppercase;letter-spacing:.4px;margin-top:3px;}
/* ── INTERVENTION DETAIL MODAL ── */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(15,29,62,.6);z-index:1200;backdrop-filter:blur(4px);align-items:center;justify-content:center;}
.modal-overlay.open{display:flex;}
.modal-box{background:white;border-radius:14px;width:min(700px,95vw);max-height:90vh;overflow-y:auto;box-shadow:0 24px 80px rgba(0,0,0,.25);}
.modal-header{background:linear-gradient(135deg,var(--blue-dark),var(--blue));color:white;padding:20px 24px;border-radius:14px 14px 0 0;display:flex;justify-content:space-between;align-items:flex-start;}
.modal-body{padding:22px 24px;}
.modal-close{background:rgba(255,255,255,.15);border:none;color:white;font-size:18px;cursor:pointer;border-radius:6px;padding:4px 10px;transition:background .15s;}
.modal-close:hover{background:rgba(255,255,255,.3);}
.modal-section{margin-bottom:18px;}
.modal-section-title{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--gray3);margin-bottom:8px;padding-bottom:4px;border-bottom:1px solid var(--gray2);}
.modal-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.modal-field{background:var(--gray);border-radius:6px;padding:8px 12px;}
.modal-field label{display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--gray3);margin-bottom:3px;}
.modal-field .mfv{font-size:13px;font-weight:600;color:var(--gray4);}
/* Admin editable field */
.modal-field.editable .mfv{border:none;background:transparent;font-family:var(--font);font-size:13px;font-weight:600;color:var(--gray4);width:100%;outline:none;cursor:pointer;border-bottom:2px dashed var(--blue);padding:0;}
/* ── LOA RELATIONSHIP ── */
.loa-badge{display:inline-flex;align-items:center;gap:5px;background:var(--teal-light);border:1.5px solid var(--teal);border-radius:6px;padding:4px 10px;font-size:11px;font-weight:700;color:var(--teal);cursor:pointer;transition:all .15s;}
.loa-badge:hover{background:var(--teal);color:white;}
.related-int-pill{display:inline-flex;align-items:center;gap:4px;background:var(--blue-light);border:1px solid #C5D8F5;border-radius:5px;padding:3px 8px;font-size:10px;cursor:pointer;color:var(--blue);font-weight:600;transition:all .15s;margin:2px;}
.related-int-pill:hover{background:var(--blue);color:white;}
/* ── OVERLAY ── */
.panel-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;backdrop-filter:blur(2px);}
.panel-overlay.open{display:block;}
/* ── ADMIN MODE ── */
.admin-bar{display:none;background:linear-gradient(90deg,var(--amber-light),#FFF8E8);border-bottom:2px solid var(--amber);padding:8px 24px;font-size:11px;font-weight:700;color:var(--amber);align-items:center;gap:10px;}
.admin-bar.visible{display:flex;}
.admin-bar .admin-notice{background:var(--amber);color:white;border-radius:5px;padding:2px 10px;font-size:11px;}
/* Admin inline edit */
[data-editable]{transition:background .15s;border-radius:3px;}
.admin-mode [data-editable]{background:rgba(196,122,21,.08);outline:1px dashed var(--amber);cursor:text;padding:1px 3px;}
.admin-mode [data-editable]:focus{background:white;outline:2px solid var(--amber);}
/* ── EXPORT MENU ── */
.exp-item{padding:10px 16px;font-size:12px;color:var(--gray4);cursor:pointer;display:flex;align-items:center;gap:8px;transition:background .1s;}
.exp-item:hover{background:var(--gray);color:var(--blue);}
.exp-item:not(:last-child){border-bottom:1px solid var(--gray2);}
/* ── UPLOAD ZONE ── */
.upload-zone{border:2px dashed var(--blue-mid);border-radius:var(--radius);padding:28px;text-align:center;background:var(--blue-light);cursor:pointer;transition:all .2s;}
.upload-zone:hover,.upload-zone.drag{background:#DCE9FA;border-color:var(--blue);}
.upload-zone .uz-icon{font-size:36px;margin-bottom:10px;}
.upload-zone .uz-title{font-size:14px;font-weight:700;color:var(--blue);margin-bottom:5px;}
.upload-zone .uz-sub{font-size:11px;color:var(--gray3);}
/* ── REGIONAL TAG ── */
.regional-tag{display:inline-flex;align-items:center;gap:4px;background:var(--purple-light);border:1px solid var(--purple);border-radius:4px;padding:2px 7px;font-size:10px;font-weight:700;color:var(--purple);}
/* ── RISK ITEMS ── */
.risk-item{display:flex;gap:12px;padding:11px 14px;border-radius:8px;margin-bottom:8px;align-items:flex-start;}
.risk-item.red{background:var(--red-light);border-left:3px solid var(--red);}
.risk-item.amber{background:var(--amber-light);border-left:3px solid var(--amber);}
.risk-item.gray{background:var(--gray);border-left:3px solid var(--gray3);}
