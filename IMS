  // Milestones sheet
  const msHeaders = ["ms_id","title","date","status","color"];
  const msData = [msHeaders, ...APP_DATA.milestones.map((m,i)=>[i+1,m.title,m.date,m.done?"Completed":"Pending",m.color])];
  XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(msData), "Milestones");

  // Settings sheet
  const settData = [["setting","value"],
    ["project_name",APP_DATA.settings.projectName],
    ["project_start","2023-08-01"],["project_end","2026-07-31"],
    ["total_budget_usd",APP_DATA.settings.totalBudget],
    ["total_actuals_usd",APP_DATA.settings.totalActuals],
    ["hard_commits_usd",APP_DATA.settings.hardCommits],
    ["snapshot_date",APP_DATA.settings.snapshotDate],
