/* ═══════════════════════════════════════════════════════
   ██████████████  EXCEL UPLOAD  ██████████████
   ═══════════════════════════════════════════════════════ */
function handleDrop(e) {
  e.preventDefault();
  document.getElementById("uploadZone").classList.remove("drag");
  const file = e.dataTransfer.files[0];
  if (file) processExcelFile(file);
}
function handleExcelUpload(event) {
  const file = event.target.files[0];
  if (file) processExcelFile(file);
}
function processExcelFile(file) {
  if (!file.name.match(/\.(xlsx|xls)$/i)) {
    showToast("Please upload an .xlsx or .xls file", "red"); return;
  }
  showToast("Processing Excel file...", "");
  const reader = new FileReader();
  reader.onload = (e) => {
    try {
      const wb = XLSX.read(e.target.result, {type:"array"});
      let updated = false;

      // Parse Interventions sheet
      if (wb.SheetNames.includes("Interventions")) {
        const ws = wb.Sheets["Interventions"];
        const rows = XLSX.utils.sheet_to_json(ws);
        const byCountry = {fiji:[],samoa:[],solomon:[],regional:[]};
        rows.forEach(r => {
          const c = (r.country||"").toLowerCase();
          const key = c.includes("fiji")?"fiji":c.includes("samoa")?"samoa":c.includes("solomon")?"solomon":"regional";
          byCountry[key].push({
            id: r.int_id||"", output: r.output||"", name: r.name||"",
            status: r.status||"", loa: r.loa_id||"",
            budget: parseFloat(r.budget)||0, actual: parseFloat(r.actual)||0,
            hard: parseFloat(r.hard_commit)||0,
            start: r.start_date||"", end: r.end_date||"",
            focal: r.focal_point||"", notes: r.notes||"",
            risks: r.risks||"", kpis: r.kpis||"",
            isRegional: c.includes("regional"),
          });
        });
        Object.keys(byCountry).forEach(k => { if(byCountry[k].length) APP_DATA.interventions[k]=byCountry[k]; });
        updated = true;
      }

      // Parse Budget_Lines
      if (wb.SheetNames.includes("Budget_Lines")) {
        const ws = wb.Sheets["Budget_Lines"];
        const rows = XLSX.utils.sheet_to_json(ws);
        APP_DATA.budgetLines = rows.map(r => ({
          no: r.line_id||"",cat: r.category||"",desc: r.description||"",
          total: parseFloat(r.budget_usd)||0, actual: parseFloat(r.actual_usd)||0,
          hard: parseFloat(r.hard_commit_usd)||0,
          get bal(){return this.total-this.actual-this.hard;}
        }));
        updated = true;
      }

      // Parse Results_Framework
      if (wb.SheetNames.includes("Results_Framework")) {
        const ws = wb.Sheets["Results_Framework"];
        const rows = XLSX.utils.sheet_to_json(ws);
        APP_DATA.rfData = rows.map(r => ({
          level: r.level||"",indicator: r.indicator||"",type: r.type||"",
          baseline: r.baseline||"",prog2024: r.prog_y1||"",y2target: r.target_y2||"",
          prog2025: r.prog_y2||"",totalTarget: r.total_target||"",
          cumulative: r.cumulative||"",pct: r.pct!==undefined?parseFloat(r.pct):null,
          comments: r.comments||"",
        }));
        updated = true;
      }

      // Parse Risks_Issues
      if (wb.SheetNames.includes("Risks_Issues")) {
        const ws = wb.Sheets["Risks_Issues"];
        const rows = XLSX.utils.sheet_to_json(ws);
        APP_DATA.risksRegister = rows.map(r => ({
          severity: (r.severity||"gray").toLowerCase(),title: r.title||"",
          desc: r.description||"",owner: r.owner||"",date: r.date_logged||"",status: r.status||"Open",
        }));
        updated = true;
      }

      if (updated) {
        refreshDashboard();
        document.getElementById("dataSource").textContent = `Excel: ${file.name}`;
        document.getElementById("dataStatusPanel").innerHTML = `
          <div style="color:var(--green);font-weight:700;">✅ Excel file loaded: ${file.name}</div>
          <div style="margin-top:5px;">Sheets processed: ${wb.SheetNames.join(", ")}</div>
          <div style="margin-top:5px;color:var(--gray3);">Dashboard refreshed at ${new Date().toLocaleTimeString()}</div>`;
        showToast("Dashboard refreshed from Excel!", "green");
        searchIndex = null; // Reset search index
      } else {
        showToast("No matching sheets found in the file", "red");
      }
    } catch(err) {
      showToast("Error parsing Excel: " + err.message, "red");
    }
  };
  reader.readAsArrayBuffer(file);
}

function refreshDashboard() {
  // Invalidate caches
  invalidateIntsCache();
  searchIndex = null;
  // Re-render all dynamic sections
  renderKpis("exec-kpis", APP_DATA.execKpis);
  renderKpis("fin-kpis", APP_DATA.finKpis);
  renderTrafficLights();
  renderTimeline();
  renderScorecards();
  renderHighlightsRisks();
  renderBurnRate();
  renderFinSummary();
  renderBudget("all");
  renderBudgetKpis();
  renderLoaStatus();
  renderLoaDetail();
  renderLoaFin();
  renderModalityGroups();
  renderCountryCards();
  renderIntKpis();
  renderLoaKpis();
  renderRFGauges();
  renderRF("all");
  renderRisksRegister();
  rebuildCharts();
}

function rebuildCharts() {
  Object.values(charts).forEach(c => c.destroy());
  charts = {};
  initCharts();
}

