/* ═══════════════════════════════════════════════════════
   ██████████████  PROGRAMME GANTT ENGINE  ██████████████
   ═══════════════════════════════════════════════════════ */

(function() {

/* ── Config ── */
let _ganttZoom  = 'all';    // 'all' | 'current' | 'year'
let _ganttGroup = 'country'; // 'country' | 'status'

window.setGanttZoom = function(v) {
  _ganttZoom = v;
  ['all','current','year'].forEach(k => {
    const b = document.getElementById('gz-'+k);
    if(b) b.classList.toggle('active', k===v);
  });
  renderProgrammeGantt();
};
window.setGanttGroup = function(v) {
  _ganttGroup = v;
  ['country','status'].forEach(k => {
    const b = document.getElementById('gg-'+k);
    if(b) b.classList.toggle('active', k===v);
  });
  renderProgrammeGantt();
};

/* ── Date parser (same as inline Gantt) ── */
function pd(s) {
  if (!s || s==='—') return null;
  const mo = {Jan:0,Feb:1,Mar:2,Apr:3,May:4,Jun:5,Jul:6,Aug:7,Sep:8,Oct:9,Nov:10,Dec:11};
  s = s.trim();
  let m;
  m = s.match(/^(\d{1,2})\s+([A-Za-z]{3})\s+(\d{4})$/);
  if(m) return new Date(+m[3],mo[m[2]],+m[1]);
  m = s.match(/^(\d{1,2})-([A-Za-z]{3})-(\d{4})$/);
  if(m) return new Date(+m[3],mo[m[2]],+m[1]);
  m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
  if(m) return new Date(+m[3],+m[2]-1,+m[1]);
  m = s.match(/^([A-Za-z]{3})\s+(\d{4})$/);
  if(m) return new Date(+m[2],mo[m[1]],1);
  m = s.match(/^(\d{4})$/);
  if(m) return new Date(+m[1],0,1);
  const d = new Date(s);
  return isNaN(d)?null:d;
}

/* ── Compute view window from zoom setting ── */
function getViewWindow() {
  const t = new Date(today);
  if (_ganttZoom === 'current') {
    const s = new Date(t); s.setMonth(s.getMonth()-6); s.setDate(1);
    const e = new Date(t); e.setMonth(e.getMonth()+7); e.setDate(0);
    return {start:s, end:e};
  }
  if (_ganttZoom === 'year') {
    return {start:new Date(2026,0,1), end:new Date(2026,11,31)};
  }
  // 'all' — full programme + 1 month padding
  return {start:new Date(2023,7,1), end:new Date(2028,2,28)};
}

/* ── Build month columns list ── */
function buildMonths(vStart, vEnd) {
  const months = [];
  const cur = new Date(vStart.getFullYear(), vStart.getMonth(), 1);
  const end = new Date(vEnd.getFullYear(), vEnd.getMonth()+1, 1);
  while(cur < end) {
    months.push(new Date(cur));
    cur.setMonth(cur.getMonth()+1);
  }
  return months;
}

/* ── pct position within view window ── */
function pctOf(d, vStart, vSpan) {
  return Math.max(0, Math.min(100, ((d-vStart)/vSpan)*100));
}

/* ── Status colour mapping ── */
const STATUS_COLOR = {
  'Active':              '#1B4F9B',
  'Operational':         '#0F7B6C',
  'Completed':           '#0F7B6C',
  'Closed (Completed)':  '#0F7B6C',
  'Expired':             '#B83232',
  'Overdue':             '#B83232',
  'Under Development':   '#C47A15',
  'Under Review':        '#3B7DD8',
  'To be Developed':     '#9399A8',
  'Not Started':         '#9399A8',
  'On Order':            '#0F7B6C',
  'Delivered':           '#2E7D32',
  'Under Evaluation':    '#C47A15',
};
function barColor(status) { return STATUS_COLOR[status] || '#3B7DD8'; }

const STATUS_PILL = {
  'Active':'green','Operational':'green','Completed':'teal','Closed (Completed)':'teal',
  'Expired':'red','Overdue':'red','Under Development':'amber','Under Review':'blue',
  'To be Developed':'gray','Not Started':'gray',
};

/* ── Groups config ── */
const COUNTRY_GROUPS = [
  {key:'Fiji',         label:'Fiji',                  flag:'🇫🇯'},
  {key:'Samoa',        label:'Samoa',                 flag:'🇼🇸'},
  {key:'Solomon Islands',label:'Solomon Islands',     flag:'🇸🇧'},
  {key:'Regional',     label:'Regional / All Countries',flag:'🌏'},
];
const STATUS_GROUPS = [
  {key:'active',    label:'Active / Operational',  statuses:['Active','Operational']},
  {key:'review',    label:'Under Review / Development', statuses:['Under Review','Under Development','To be Developed']},
  {key:'completed', label:'Completed',             statuses:['Completed','Closed (Completed)']},
  {key:'expired',   label:'Expired / Overdue',     statuses:['Expired','Overdue']},
  {key:'other',     label:'Other',                 statuses:['Not Started']},
];

/* ── Tooltip ── */
let _tip = null;
function ensureTip() {
  if(_tip) return _tip;
  _tip = document.createElement('div');
  _tip.className = 'pg-tooltip';
  _tip.id = 'pg-tooltip';
  document.body.appendChild(_tip);
  document.addEventListener('mousemove', e => {
    if(_tip.style.display==='block') {
      let x=e.clientX+14, y=e.clientY-10;
      if(x+_tip.offsetWidth>window.innerWidth) x=e.clientX-_tip.offsetWidth-10;
      if(y+_tip.offsetHeight>window.innerHeight) y=e.clientY-_tip.offsetHeight-10;
      _tip.style.left=x+'px'; _tip.style.top=y+'px';
    }
  });
  return _tip;
}
function showTip(html) { const t=ensureTip(); t.innerHTML=html; t.style.display='block'; }
function hideTip() { const t=ensureTip(); t.style.display='none'; }

/* ── Main render ── */
function renderProgrammeGantt() {
  const wrap = document.getElementById('gantt-chart-inner');
  if(!wrap) return;

  const loas = (APP_DATA.loas||[]).filter(l=>l.modality==='loa');
  if(!loas.length){ wrap.innerHTML='<div class="pg-empty">No LOA data available.</div>'; return; }

  const vw = getViewWindow();
  const vSpan = vw.end - vw.start;
  const months = buildMonths(vw.start, vw.end);
  const todayD = new Date(today);

  /* ── Header HTML ── */
  // Year super-row
  const yearMap = {};
  months.forEach(m => {
    const y = m.getFullYear();
    yearMap[y] = (yearMap[y]||0)+1;
  });
  const yearHeaderCells = Object.entries(yearMap).map(([y,cnt]) =>
    `<div class="pg-year-cell" style="flex:${cnt};">${y}</div>`
  ).join('');

  const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const monthHeaderCells = months.map((m,i) => {
    const isYearStart = m.getMonth()===0 && i>0;
    return `<div class="pg-month${isYearStart?' year-start':''}">${monthNames[m.getMonth()]}</div>`;
  }).join('');

  const headerHtml = `
    <div class="pg-header">
      <div class="pg-row-label" style="flex-direction:column;justify-content:center;padding:0 14px;">
        <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;opacity:.85;">Contract / LoA</div>
        <div style="font-size:9px;opacity:.65;margin-top:2px;">${loas.length} agreements</div>
      </div>
      <div style="flex:1;display:flex;flex-direction:column;">
        <div class="pg-year-header">${yearHeaderCells}</div>
        <div class="pg-timeline">${monthHeaderCells}</div>
      </div>
    </div>`;

  /* ── Track: month grid lines + today ── */
  function buildTrackBg(extraContent='') {
    const monthLines = months.map((m,i) => {
      const x = pctOf(m, vw.start, vSpan);
      const isYear = m.getMonth()===0 && i>0;
      return `<div class="${isYear?'pg-year-line':'pg-month-line'}" style="left:${x}%"></div>`;
    }).join('');

    let todayLine = '';
    if(todayD >= vw.start && todayD <= vw.end) {
      const tx = pctOf(todayD, vw.start, vSpan);
      todayLine = `<div class="pg-today" style="left:${tx}%"></div>`;
    }
    return monthLines + todayLine + extraContent;
  }

  /* ── Build a single LOA row ── */
  function buildLoaRow(l) {
    const start = pd(l.start);
    const end   = pd(l.end);
    const hasBar = start && end && !isNaN(start) && !isNaN(end);

    const pill = STATUS_PILL[l.status]||'gray';
    const pillColors = {green:'#2E7D32',teal:'#0F7B6C',amber:'#C47A15',red:'#B83232',blue:'#1B4F9B',gray:'#9399A8'};
    const pillBg = {green:'#E8F5E9',teal:'#E0F4F1',amber:'#FDF3E0',red:'#FDECEC',blue:'#E8F0FB',gray:'#E8EAF0'};
    const pc = pillColors[pill]||'#9399A8';
    const pb = pillBg[pill]||'#E8EAF0';

    // Label cell
    const labelHtml = `
      <div class="pg-row-lbl" onclick="openLoaModal('${l.id}')" title="Click to open LOA details">
        <div class="pg-loa-id">${l.id}</div>
        <div class="pg-loa-name">${l.name}</div>
        <div style="display:flex;align-items:center;gap:5px;margin-top:2px;">
          <div class="pg-loa-status" style="background:${pb};color:${pc};">${l.status}</div>
          ${l.budgetUSD?`<span style="font-size:9px;color:var(--gray3);font-weight:600;">$${Math.round(l.budgetUSD/1000)}K</span>`:''}
        </div>
        ${l.partner?`<div class="pg-loa-partner">${l.partner}</div>`:''}
      </div>`;

    // Track cell
    let trackContent = '';

    if(hasBar) {
      const bLeft = pctOf(start, vw.start, vSpan);
      const bRight = pctOf(end, vw.start, vSpan);
      const bW = Math.max(bRight - bLeft, 0.4);
      const bc = barColor(l.status);

      // Truncate label to fit — show if bar >8%
      const barLabel = bW > 8 ? l.id : '';

      trackContent += `<div class="pg-bar"
        style="left:${bLeft}%;width:${bW}%;background:${bc};"
        onmouseenter="showTip(\`<strong>${l.name.replace(/`/g,"'")}</strong>
          <div class='pt-row'><span>ID:</span><span>${l.id}</span></div>
          <div class='pt-row'><span>Status:</span><span>${l.status}</span></div>
          <div class='pt-row'><span>Start:</span><span>${l.start||'—'}</span></div>
          <div class='pt-row'><span>End:</span><span>${l.end||'—'}</span></div>
          ${l.budgetUSD?`<div class='pt-row'><span>Budget:</span><span>USD ${l.budgetUSD.toLocaleString()}</span></div>`:''}
          ${l.partner?`<div class='pt-row'><span>Partner:</span><span>${l.partner.replace(/`/g,"'")}</span></div>`:''}
        \`)"
        onmouseleave="hideTip()"
        onclick="openLoaModal('${l.id}')">
        <span class="pg-bar-label">${barLabel}</span>
      </div>`;

      // Workplan events
      if(l.workplan && l.workplan.length) {
        l.workplan.forEach(wp => {
          const wd = pd(wp.date);
          if(!wd || isNaN(wd)) return;
          const wx = pctOf(wd, vw.start, vSpan);
          if(wx < 0 || wx > 100) return;

          if(wp.type==='report') {
            const rCol = {Submitted:'#0F7B6C',Overdue:'#B83232',Pending:'#C47A15'}[wp.status]||'#C47A15';
            trackContent += `<div class="pg-report" style="left:${wx}%;background:${rCol};border:1.5px solid white;"
              onmouseenter="showTip(\`<strong>📋 ${wp.label.replace(/`/g,"'")}</strong><div class='pt-row'><span>Type:</span><span>Report</span></div><div class='pt-row'><span>Status:</span><span>${wp.status||'Pending'}</span></div><div class='pt-row'><span>Date:</span><span>${wp.date}</span></div>\`)"
              onmouseleave="hideTip()"></div>`;
          } else {
            // Milestone diamond
            trackContent += `<div class="pg-milestone" style="background:#fff;border:2.5px solid #1B4F9B;"
              onmouseenter="showTip(\`<strong>◆ ${wp.label.replace(/`/g,"'")}</strong><div class='pt-row'><span>Type:</span><span>Milestone</span></div><div class='pt-row'><span>Date:</span><span>${wp.date}</span></div>\`)"
              onmouseleave="hideTip()"
              data-left="${wx}"></div>`;
            // NB: left applied via JS after render to avoid template literal complexity
          }
        });
      }
    } else {
      trackContent += `<div style="position:absolute;left:8px;top:50%;transform:translateY(-50%);font-size:10px;color:var(--gray3);font-style:italic;">No timeline data</div>`;
    }

    return `<div class="pg-row">
      ${labelHtml}
      <div class="pg-track">
        ${buildTrackBg(trackContent)}
      </div>
    </div>`;
  }

  /* ── Build groups ── */
  let groupsHtml = '';
  const groups = _ganttGroup === 'country' ? COUNTRY_GROUPS : STATUS_GROUPS;

  groups.forEach(g => {
    let groupLoas;
    if(_ganttGroup==='country') {
      groupLoas = loas.filter(l => l.country === g.key);
    } else {
      groupLoas = loas.filter(l => g.statuses.includes(l.status));
    }
    if(!groupLoas.length) return;

    const gId = 'pg-grp-'+g.key.replace(/\s/g,'_');
    const rows = groupLoas.map(buildLoaRow).join('');

    groupsHtml += `
      <div class="pg-group-header" onclick="togglePgGroup('${gId}')">
        ${g.flag?`<span class="pg-group-flag">${g.flag}</span>`:''}
        <span class="pg-group-name">${g.label}</span>
        <span class="pg-group-count">${groupLoas.length} LoA${groupLoas.length!==1?'s':''}</span>
        <span class="pg-group-toggle" id="${gId}-arrow">▼</span>
      </div>
      <div class="pg-group-body" id="${gId}">${rows}</div>`;
  });

  wrap.innerHTML = headerHtml + groupsHtml;

  // Position milestone diamonds (need to set 'left' after DOM insertion)
  wrap.querySelectorAll('.pg-milestone[data-left]').forEach(el => {
    el.style.left = el.dataset.left + '%';
    el.removeAttribute('data-left');
  });
}

/* ── Group toggle ── */
window.togglePgGroup = function(gId) {
  const body  = document.getElementById(gId);
  const arrow = document.getElementById(gId+'-arrow');
  if(!body) return;
  const isOpen = body.style.display !== 'none';
  body.style.display = isOpen ? 'none' : 'block';
  if(arrow) arrow.style.transform = isOpen ? 'rotate(-90deg)' : '';
};

/* ── Expose tip functions globally ── */
window.showTip = showTip;
window.hideTip = hideTip;

/* ── Render when tab activated ── */
const _origShowTab = window.showTab;
window.showTab = function(name) {
  _origShowTab(name);
  if(name==='gantt') renderProgrammeGantt();
};

/* ── Also render if Gantt is active on load ── */
document.addEventListener('DOMContentLoaded', () => {
  if(document.getElementById('page-gantt') && document.getElementById('page-gantt').classList.contains('active')) {
    renderProgrammeGantt();
  }
});

})(); // end Gantt IIFE

</script>
