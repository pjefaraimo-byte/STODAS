/* ── INLINE GANTT BAR ── */
.gantt-wrap{font-size:10px;color:var(--gray3);}
.gantt-dates{display:flex;justify-content:space-between;margin-bottom:3px;font-size:9px;color:var(--gray3);}
.gantt-track{position:relative;height:18px;background:var(--gray2);border-radius:4px;overflow:visible;}
.gantt-bar{position:absolute;top:2px;height:14px;border-radius:3px;opacity:.85;}
.gantt-today{position:absolute;top:-3px;width:2px;height:24px;background:var(--red);border-radius:1px;z-index:10;}
.gantt-today::after{content:'▼';position:absolute;top:-8px;left:-4px;font-size:8px;color:var(--red);}
/* gantt event bars — see renderGanttBar inline styles */
.gantt-evbar:hover::after{content:attr(title);position:absolute;bottom:20px;left:50%;transform:translateX(-50%);background:var(--gray4);color:white;border-radius:5px;padding:3px 7px;font-size:10px;white-space:nowrap;z-index:100;pointer-events:none;}
/* workplan pips on table Gantt */
.gantt-pip{position:absolute;top:1px;width:4px;height:16px;border-radius:2px;transform:translateX(-50%);z-index:5;cursor:default;transition:transform .1s;}
.gantt-pip:hover{transform:translateX(-50%) scaleY(1.25);}

/* ═══════════════════════════════════════
   PROGRAMME GANTT CHART  — v5 Design
   ═══════════════════════════════════════ */
#gantt-chart-inner{min-width:900px;font-family:var(--font);}

/* Header: month columns */
.pg-header{display:flex;border-bottom:2px solid var(--blue);background:linear-gradient(135deg,var(--blue-dark),var(--blue));color:white;position:sticky;top:0;z-index:30;}
.pg-row-label{flex-shrink:0;width:260px;min-width:260px;padding:10px 14px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;border-right:1px solid rgba(255,255,255,.15);}
.pg-timeline{flex:1;display:flex;position:relative;}
.pg-month{flex:1;text-align:center;font-size:9px;font-weight:700;letter-spacing:.3px;padding:5px 0;border-right:1px solid rgba(255,255,255,.1);white-space:nowrap;overflow:hidden;}
.pg-month.year-start{border-left:2px solid rgba(255,255,255,.4);background:rgba(255,255,255,.08);}

/* Year super-header */
.pg-year-header{display:flex;border-bottom:1px solid rgba(255,255,255,.2);}
.pg-year-cell{text-align:center;font-size:11px;font-weight:700;padding:5px 0;border-right:1px solid rgba(255,255,255,.2);}

/* Country / group dividers */
.pg-group-header{display:flex;align-items:center;background:var(--blue-light);border-bottom:2px solid var(--blue-mid);padding:7px 14px;gap:10px;cursor:pointer;user-select:none;transition:background .15s;}
.pg-group-header:hover{background:#D0E2FA;}
.pg-group-flag{font-size:18px;}
.pg-group-name{font-size:12px;font-weight:700;color:var(--blue-dark);flex:1;}
.pg-group-count{font-size:10px;font-weight:600;color:var(--blue);background:rgba(27,79,155,.12);border-radius:10px;padding:2px 8px;}
.pg-group-toggle{font-size:12px;color:var(--blue);transition:transform .2s;}
.pg-group-body{}

/* LOA row */
.pg-row{display:flex;align-items:center;border-bottom:1px solid var(--gray2);min-height:44px;transition:background .1s;}
.pg-row:hover{background:#F0F5FF;}
.pg-row-lbl{flex-shrink:0;width:260px;min-width:260px;padding:8px 14px;border-right:1px solid var(--gray2);display:flex;flex-direction:column;gap:3px;cursor:pointer;}
.pg-row-lbl:hover .pg-loa-name{color:var(--blue);}
.pg-loa-id{font-size:9px;font-weight:700;font-family:var(--mono);color:var(--gray3);letter-spacing:.3px;}
.pg-loa-name{font-size:11px;font-weight:600;color:var(--gray4);line-height:1.35;word-break:break-word;}
.pg-loa-partner{font-size:9px;color:var(--gray3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.pg-loa-status{display:inline-flex;align-items:center;gap:3px;font-size:9px;font-weight:700;border-radius:3px;padding:1px 6px;white-space:nowrap;width:fit-content;}

/* Timeline track */
.pg-track{flex:1;position:relative;height:44px;overflow:visible;}
.pg-month-line{position:absolute;top:0;bottom:0;width:1px;background:var(--gray2);pointer-events:none;}
.pg-year-line{position:absolute;top:0;bottom:0;width:2px;background:#C5D8F5;pointer-events:none;z-index:2;}

/* The LOA bar */
.pg-bar{position:absolute;top:50%;transform:translateY(-50%);height:18px;border-radius:4px;cursor:pointer;transition:filter .15s,height .15s;display:flex;align-items:center;overflow:visible;z-index:10;}
.pg-bar:hover{filter:brightness(1.1);height:22px;z-index:20;}
.pg-bar-label{color:white;font-size:9px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:0 6px;text-shadow:0 1px 2px rgba(0,0,0,.3);pointer-events:none;}

/* Milestone diamond */
.pg-milestone{position:absolute;top:50%;z-index:15;transform:translate(-50%,-50%) rotate(45deg);width:9px;height:9px;cursor:pointer;transition:transform .15s;}
.pg-milestone:hover{transform:translate(-50%,-50%) rotate(45deg) scale(1.5);z-index:25;}

/* Report pip (square, taller than bar) */
.pg-report{position:absolute;top:50%;transform:translate(-50%,-50%);width:7px;height:22px;border-radius:2px;z-index:14;cursor:pointer;transition:transform .15s;}
.pg-report:hover{transform:translate(-50%,-50%) scaleY(1.2);z-index:24;}

/* Today line */
.pg-today{position:absolute;top:0;bottom:0;width:2px;background:#B83232;z-index:20;pointer-events:none;}
.pg-today::before{content:'TODAY';position:absolute;top:2px;left:4px;font-size:8px;font-weight:700;color:#B83232;white-space:nowrap;letter-spacing:.5px;}

/* Tooltip */
.pg-tooltip{display:none;position:fixed;background:var(--gray4);color:white;border-radius:8px;padding:9px 12px;font-size:11px;z-index:1000;box-shadow:var(--shadow-lg);max-width:280px;line-height:1.5;pointer-events:none;}
.pg-tooltip strong{display:block;font-size:12px;margin-bottom:4px;}
.pg-tooltip .pt-row{display:flex;gap:8px;font-size:10px;opacity:.85;}

/* Budget ticks below bar */
.pg-budget-label{position:absolute;bottom:2px;font-size:8px;color:var(--gray3);white-space:nowrap;pointer-events:none;font-weight:600;}

/* Empty state */
.pg-empty{padding:40px;text-align:center;color:var(--gray3);font-size:13px;}

/* Print */
@media print{
  #gantt-chart-wrap{overflow:visible!important;}
  .pg-header{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
  .pg-group-header{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
  .pg-bar{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
}
</style>
</head>
