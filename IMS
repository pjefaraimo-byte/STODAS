/* ── Render workplan timeline for a given LoA ─────────────────── */
function renderLoaTimeline(loaId) {
  const loa = APP_DATA.loas.find(l => l.id === loaId);
  if (!loa) return "";

  // Prefer the rich LOA_WORKPLANS entry; fall back to normalising l.workplan
  let wp = LOA_WORKPLANS[loaId];
  if (!wp && loa.workplan && loa.workplan.length) {
    // Normalise l.workplan [{date, label, type, status}] → {milestones, reports, deliverables}
    wp = {milestones:[], reports:[], deliverables:[]};
    loa.workplan.forEach(item => {
      const entry = {date: item.date, label: item.label, status: item.status || "Pending",
                     type: item.type || "milestone"};
      if (item.type === "report") {
        wp.reports.push(entry);
      } else if (item.type === "deliverable") {
        wp.deliverables.push(entry);
      } else {
        wp.milestones.push(entry);
      }
    });
  }
  if (!wp) return "";

  const today = new Date();
  const in30  = new Date(today); in30.setDate(in30.getDate()+30);

  const startD = parseLoaDate(loa.start);
  const endD   = parseLoaDate(loa.end);
  if (!startD || !endD) return "";

  const totalMs = endD - startD;
  const elapsedMs = Math.max(0, Math.min(today - startD, totalMs));
  const elapsedPct = Math.round(elapsedMs / totalMs * 100);

  // Collect all markers
  const allMarkers = [
    ...(wp.milestones||[]).map(m=>({...m,kind:"milestone"})),
    ...(wp.reports||[]).map(r=>({...r,kind:"report"})),
    ...(wp.deliverables||[]).map(d=>({...d,kind:"deliverable"})),
  ];

  // Stats
  const total = allMarkers.length;
  const done  = allMarkers.filter(m => m.status==="Completed").length;
  const msDone = total > 0 ? Math.round(done/total*100) : 0;

  // Determine colour / icon per marker
  function markerStyle(m) {
    const d = parseLoaDate(m.date);
    const overdue = d && d < today && m.status !== "Completed";
    const soon    = d && d >= today && d <= in30 && m.status !== "Completed";
    const color   = m.status === "Completed" ? "var(--green)"
                  : overdue                   ? "var(--red)"
                  : soon                      ? "var(--amber)"
                  : m.status === "In Progress"? "var(--blue)"
                  : "var(--gray3)";
    const icon    = m.kind === "milestone" ? "●"
                  : m.kind === "report"    ? "◆"
                  : m.kind === "final"     ? "■"
                  : "▲";
    const pos     = d ? Math.max(0, Math.min(100, (d - startD) / totalMs * 100)) : 0;
    return {color, icon, pos, overdue, soon};
  }

  const markersHtml = allMarkers.map((m,i) => {
    const s = markerStyle(m);
    const d = parseLoaDate(m.date);
    const dateStr = d ? d.toLocaleDateString("en-GB",{day:"2-digit",month:"short",year:"numeric"}) : "—";
    const statusBg = m.status==="Completed"?"#EAFAF1":s.overdue?"#FEE":s.soon?"#FFF8E1":"#EEF4FF";
    const statusCol = m.status==="Completed"?"var(--green)":s.overdue?"var(--red)":s.soon?"var(--amber)":"var(--blue)";
    const isRpt = m.kind === 'report' || m.kind === 'final';
    const isDel = m.kind === 'deliverable';
    const barHeight = isRpt ? 20 : isDel ? 16 : 14;
    const barWidth  = isRpt ? 6  : isDel ? 5  : 4;
    const barTop    = Math.round((28 - barHeight) / 2); // centre in 28px track
    return `<div class="tl-marker" style="left:${s.pos}%;position:absolute;transform:translateX(-50%);z-index:${i+1};">
      <div class="tl-bar" style="background:${s.color};width:${barWidth}px;height:${barHeight}px;border-radius:2px;border:1px solid rgba(255,255,255,0.7);box-shadow:0 0 0 1.5px ${s.color};cursor:pointer;position:absolute;top:${barTop}px;left:50%;transform:translateX(-50%);" title="${m.label} — ${dateStr} — ${m.status}"></div>
      <div class="tl-tooltip" style="display:none;position:absolute;bottom:30px;left:50%;transform:translateX(-50%);min-width:160px;max-width:220px;background:white;border-radius:8px;box-shadow:0 4px 20px rgba(0,0,0,.18);padding:9px 11px;z-index:100;pointer-events:none;">
        <div style="font-size:11px;font-weight:700;color:var(--gray4);margin-bottom:4px;">${m.label}</div>
        <div style="display:flex;justify-content:space-between;align-items:center;gap:6px;">
          <span style="font-size:10px;color:var(--gray3);">${dateStr}</span>
          <span style="font-size:9px;font-weight:700;padding:2px 6px;border-radius:8px;background:${statusBg};color:${statusCol};">${m.status}</span>
        </div>
        <div style="font-size:9px;color:var(--gray3);margin-top:3px;text-transform:capitalize;">${m.kind==="final"?"Final Report":m.kind}</div>
      </div>
    </div>`;
  }).join("");

  const amended = loa.amendments && loa.amendments !== "None" && loa.amendments.trim();

  return `
    <div style="background:var(--gray);border-radius:9px;padding:14px 16px;margin-bottom:12px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;flex-wrap:wrap;gap:6px;">
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--gray3);">
          📅 Workplan Timeline
          ${amended?`<span style="background:#FFF8E1;color:var(--amber);border:1px solid var(--amber);border-radius:5px;padding:2px 7px;font-size:9px;font-weight:700;margin-left:6px;">AMENDED</span>`:""}
        </div>
        <div style="display:flex;gap:12px;font-size:10px;color:var(--gray3);">
          <span>🕐 ${elapsedPct}% elapsed</span>
          <span>✅ ${msDone}% milestones done (${done}/${total})</span>
        </div>
      </div>

      <!-- Timeline bar -->
      <div style="position:relative;height:28px;margin:8px 0 24px;">
        <!-- Track -->
        <div style="position:absolute;top:7px;left:0;right:0;height:8px;background:var(--gray2);border-radius:4px;"></div>
        <!-- Progress fill -->
        <div style="position:absolute;top:7px;left:0;width:${elapsedPct}%;height:8px;background:linear-gradient(90deg,var(--blue),var(--teal));border-radius:4px;"></div>
        <!-- Today indicator -->
        <div style="position:absolute;top:0;left:${elapsedPct}%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;">
          <div style="width:2px;height:22px;background:var(--red);"></div>
          <div style="font-size:7px;color:var(--red);font-weight:700;white-space:nowrap;margin-top:1px;">TODAY</div>
        </div>
        <!-- Markers -->
        <div style="position:relative;height:100%;" id="tl-markers-${loaId.replace(/-/g,'_')}">${markersHtml}</div>
      </div>

      <!-- Date labels -->
      <div style="display:flex;justify-content:space-between;font-size:9px;color:var(--gray3);margin-top:2px;">
        <span>▶ ${loa.start}</span>
