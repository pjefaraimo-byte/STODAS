          <span style="display:inline-flex;align-items:center;gap:3px;"><span style="display:inline-block;width:5px;height:14px;border-radius:2px;background:var(--red);"></span>Overdue</span>
        </span>
      </div>
    </div>`;
}

/* ── Hook into openLoaModal to inject timeline ───────────────── */
const _stodas_origOpenLoa = window.openLoaModal;
window.openLoaModal = function(loaId) {
  _stodas_origOpenLoa(loaId);
  // After modal renders, inject/refresh timeline
  setTimeout(() => {
    const body = document.getElementById("loaModalBody");
    if (!body) return;
    // Remove any previous injection so it always reflects current data
    const prev = body.querySelector(".stodas-timeline-injected");
    if (prev) prev.remove();
    const tl = renderLoaTimeline(loaId);
    if (!tl) return;
    const firstSection = body.querySelector(".modal-section");
    if (firstSection) {
      const wrapper = document.createElement("div");
      wrapper.className = "stodas-timeline-injected";
      wrapper.innerHTML = `<div class="modal-section">${tl}</div>`;
      firstSection.insertAdjacentElement("afterend", wrapper);
      attachTimelineTooltips(body);
    }
  }, 60);
};

/* ── Tooltip hover behaviour ─────────────────────────────────── */
function attachTimelineTooltips(container) {
  container.querySelectorAll(".tl-marker").forEach(marker => {
    const bar = marker.querySelector(".tl-bar");
    const tip = marker.querySelector(".tl-tooltip");
    if (!bar || !tip) return;
    bar.addEventListener("mouseenter", () => { tip.style.display="block"; });
    bar.addEventListener("mouseleave", () => { tip.style.display="none"; });
  });
}

