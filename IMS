/* ══════════════════════════════════════
   LOGIN SCREEN
   ══════════════════════════════════════ */
#loginScreen{position:fixed;inset:0;background:linear-gradient(135deg,var(--blue-dark) 0%,var(--blue) 55%,var(--blue-mid) 100%);z-index:9000;display:flex;align-items:center;justify-content:center;padding:20px;}
