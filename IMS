        <!-- track -->
        <path d="${trackD}" fill="none" stroke="var(--gray2)" stroke-width="10" stroke-linecap="round"/>
        <!-- fill -->
        <path d="${trackD}" fill="none" stroke="${col}" stroke-width="10" stroke-linecap="round"
          stroke-dasharray="${circumference}" stroke-dashoffset="${offset}"
          style="transition:stroke-dashoffset .8s ease;"/>
        <!-- centre text -->
        <text x="${cx}" y="${cy-4}" text-anchor="middle" font-size="17" font-weight="700" fill="${col}">${pct}%</text>
        <text x="${cx}" y="${cy+10}" text-anchor="middle" font-size="8.5" fill="var(--gray3)">${r.cumulative}</text>
