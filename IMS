.mp-back{background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);color:white;border-radius:7px;padding:6px 13px;font-size:11px;font-weight:700;font-family:var(--font);cursor:pointer;display:flex;align-items:center;gap:5px;transition:background .15s;}
