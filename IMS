  const kpiData = [kpiHeaders, ...APP_DATA.execKpis.map((k,i)=>[i+1,k.label,k.val,k.sub,k.cls||"",k.dot||""])];
  XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(kpiData), "Dashboard_KPIs");

  XLSX.writeFile(wb, "STODAS_Data_Template.xlsx");
  showToast("Template downloaded: STODAS_Data_Template.xlsx", "green");
}

