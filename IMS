function exportHistoryCSV() {
  const allUpdates = [];
  mpCurrentActivities.forEach(a => {
    const hist = progressDB[a.id]||[];
    hist.forEach(u => allUpdates.push({...u, actName:a.name}));
  });
  if (!allUpdates.length) { showToast("No updates to export.", "red"); return; }
  allUpdates.sort((a,b)=>new Date(a.createdAt)-new Date(b.createdAt));

  const headers = ["Update_ID","Activity_ID","Activity_Name","LOA_ID","Country","Progress_%","Status","Notes","Challenges","Mitigation","Next_Steps","Meeting_Reference","Attachments","Updated_By","Created_At"];
  const rows = allUpdates.map(u=>[u.id,u.activityId,'"'+(u.actName||"").replace(/"/g,'""')+'"',u.loaId,u.country,u.pct,u.status,'"'+(u.notes||"").replace(/"/g,'""')+'"','"'+(u.challenges||"").replace(/"/g,'""')+'"','"'+(u.mitigation||"").replace(/"/g,'""')+'"','"'+(u.nextSteps||"").replace(/"/g,'""')+'"',u.meetingRef||"",(u.attachments||[]).join("|"),u.updatedBy,u.createdAt]);
  const csv = headers.join(",") + "\n" + rows.map(r=>r.join(",")).join("\n");
  const blob = new Blob([csv],{type:"text/csv"});
  const a = document.createElement("a"); a.href=URL.createObjectURL(blob);
  a.download = (mpCurrentLoa?.id||"LOA")+"_Progress_History_"+new Date().toISOString().split("T")[0]+".csv";
  a.click(); URL.revokeObjectURL(a.href);
  showToast("Progress history exported.", "green");
}

