/* ── OPEN MONITORING PANEL ── */
function openMonitoringPanel(loaId) {
  const loa = APP_DATA.loas.find(l => l.id === loaId);
  if (!loa) return;
  mpCurrentLoa = loa;

  // Gather all activities linked to this LOA
  const allActs = [
    ...(APP_DATA.interventions.fiji||[]),
    ...(APP_DATA.interventions.samoa||[]),
    ...(APP_DATA.interventions.solomon||[]),
    ...(APP_DATA.interventions.regional||[]),
  ];
  mpCurrentActivities = allActs.filter(a => a.loa === loaId);

  document.getElementById("mpTitle").textContent = loa.id + " — " + loa.name;
  document.getElementById("mpSubtitle").textContent = loa.country + " · " + loa.partner + " · " + loa.start + " – " + loa.end;

  // Permission check: coordinators only see own country
  const cu = currentUser;
  const coordCountries = {coordinator_fiji:"Fiji", coordinator_samoa:"Samoa", coordinator_solomon:"Solomon Islands"};
  if (cu && coordCountries[cu.role] && loa.country !== "Regional" && loa.country !== coordCountries[cu.role]) {
    showToast("Access denied: you can only view your own country records.", "red");
    return;
  }

  // Update button visibility
  const canUpdate = cu && ["admin","editor","coordinator_fiji","coordinator_samoa","coordinator_solomon"].includes(cu.role);
  document.getElementById("mpUpdateBtn").style.display = canUpdate ? "" : "none";

  // Populate activity dropdown in update modal
  populateUmActivityDropdown();

  // Populate history filter dropdown
  const histFilter = document.getElementById("mpHistActFilter");
  if (histFilter) {
    histFilter.innerHTML = '<option value="all">All Activities</option>' +
      mpCurrentActivities.map(a => `<option value="${a.id}">${a.id} — ${a.name.substring(0,40)}</option>`).join("");
  }

  // Populate coordinator filter
  const coordFilter = document.getElementById("mpCoordFilter");
  if (coordFilter) {
    const coords = [...new Set(mpCurrentActivities.map(a=>a.focal).filter(Boolean))];
    coordFilter.innerHTML = '<option value="all">All Coordinators</option>' +
      coords.map(c=>`<option value="${c}">${c}</option>`).join("");
  }

  switchMpTab("overview");
  renderMpOverview();
  renderMpOutputs();
  renderMpHistory();
  renderMpAlerts();

  document.getElementById("monitoringPanel").classList.add("open");
  document.body.style.overflow = "hidden";
