       ["Solomon Islands","On Track",24,"88.9%"],["Solomon Islands","Completed",1,"3.7%"],["Solomon Islands","Not Started",1,"3.7%"],["Solomon Islands","At Risk",1,"3.7%"],
       ["Regional","On Track",1,"50%"],["Regional","Not Started",1,"50%"],
     ]},
  ];
  datasets.forEach(ds => {
    let csv = ds.headers.join(",") + "\n";
    ds.rows.forEach(r => { csv += r.map(v => typeof v === "string" && v.includes(",") ? `"${v}"` : v).join(",") + "\n"; });
    const blob = new Blob([csv], {type:"text/csv"});
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = ds.name + ".csv";
    a.click();
    URL.revokeObjectURL(a.href);
  });
  showToast("CSV files downloaded", "green");
}

