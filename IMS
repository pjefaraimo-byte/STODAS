function toggleIntUpdateForm(intId) {
  const wrap = document.getElementById("intUpdateFormWrap_"+intId);
  if (wrap) wrap.style.display = wrap.style.display === "none" ? "block" : "none";
}

function submitIntUpdate(intId) {
  const note = document.getElementById("intUpd_note_"+intId)?.value?.trim();
  if (!note) { alert("Please enter a progress note."); return; }
  const update = {
    id: Date.now(),
    date: document.getElementById("intUpd_date_"+intId)?.value || new Date().toISOString().slice(0,10),
    by: document.getElementById("intUpd_by_"+intId)?.value || "Unknown",
    status: document.getElementById("intUpd_status_"+intId)?.value || "On Track",
    pct: parseInt(document.getElementById("intUpd_pct_"+intId)?.value)||0,
    note,
    challenges: document.getElementById("intUpd_challenges_"+intId)?.value || "",
    next: document.getElementById("intUpd_next_"+intId)?.value || "",
  };
  saveLoaActivityUpdate("INT:"+intId, update);
  // Update the intervention's pct in APP_DATA
  const allInts = getAllInterventions();
  const r = allInts.find(i => i.id === intId);
  if (r) { r.pct = update.pct; r.status = update.status==="Completed"?"Completed On Time":update.status==="Delayed"?"At Risk":r.status; }
  showToast("✅ Intervention update saved!", "green");
  setTimeout(() => openInterventionModal(intId), 200);
}

function closeIntModal(e) {
  if (e.target === document.getElementById("intModal")) {
    document.getElementById("intModal").classList.remove("open");
  }
}


/* ── UNIFIED ACTIVITY UPDATE STORE ──────────────────────────────
   Single source of truth for all activity progress updates.
   Backed by localStorage so data survives page refresh.
   Both the LOA modal and the monitoring panel read/write here.
   ─────────────────────────────────────────────────────────────── */
const UPDATES_KEY = "stodas_activity_updates";
function _loadUpdates() {
  try { return JSON.parse(localStorage.getItem(UPDATES_KEY) || "{}"); } catch(e) { return {}; }
}
function _saveUpdates(db) {
  try { localStorage.setItem(UPDATES_KEY, JSON.stringify(db)); } catch(e) {}
}
if (!window.loaActivityUpdates) window.loaActivityUpdates = _loadUpdates();

function getLoaActivityUpdates(actId) {
  return (window.loaActivityUpdates[actId] || []).slice().sort(
    (a,b) => new Date(b.date||b.createdAt||0) - new Date(a.date||a.createdAt||0)
  );
}
function saveLoaActivityUpdate(actId, update) {
  if (!window.loaActivityUpdates[actId]) window.loaActivityUpdates[actId] = [];
  window.loaActivityUpdates[actId].unshift(update);
  // Mirror into progressDB so the monitoring panel sees it too
  if (!progressDB[actId]) progressDB[actId] = [];
  const dbEntry = {
    id: update.id || (actId+"-upd-"+Date.now()),
    activityId: actId,
    pct: update.pct || 0,
    status: update.status || "In Progress",
    notes: update.note || update.notes || "",
    challenges: update.challenges || "",
    mitigation: update.mitigation || "",
    nextSteps: update.nextSteps || "",
    meetingRef: update.meetingRef || "",
    attachments: update.attachments || [],
    updatedBy: update.by || update.updatedBy || "Unknown",
    createdAt: update.createdAt || new Date().toISOString(),
  };
  if (!progressDB[actId].find(e => e.id === dbEntry.id)) {
    progressDB[actId].push(dbEntry);
    progressDB[actId].sort((a,b) => new Date(a.createdAt) - new Date(b.createdAt));
  }
  _saveUpdates(window.loaActivityUpdates);
}

/* ── CACHED getAllInterventions() ────────────────────────────────
   Replaces the 6+ separate inline array spreads scattered throughout.
   Rebuild cache only when APP_DATA.interventions changes.
   ─────────────────────────────────────────────────────────────── */
let _allIntsCache = null;
function getAllInterventions() {
  if (_allIntsCache) return _allIntsCache;
  _allIntsCache = [
    ...(APP_DATA.interventions.fiji||[]),
    ...(APP_DATA.interventions.samoa||[]),
    ...(APP_DATA.interventions.solomon||[]),
    ...(APP_DATA.interventions.regional||[]),
  ];
  return _allIntsCache;
}
function invalidateIntsCache() { _allIntsCache = null; }



