function saveProgressUpdate() {
  const actId = document.getElementById("umActivity").value;
  if (!actId) { showToast("Please select an activity.", "red"); return; }
  const notes = document.getElementById("umNotes").value.trim();
  if (!notes) { showToast("Progress notes are required.", "red"); return; }
  const dateVal = document.getElementById("umDate").value;
  if (!dateVal) { showToast("Please select an update date.", "red"); return; }

  const act = mpCurrentActivities.find(a=>a.id===actId);
  const pct = parseInt(document.getElementById("umPct").value)||0;
  const status = document.getElementById("umStatus").value;
  const attRaw = document.getElementById("umAttachments").value.trim();
  const attachments = attRaw ? attRaw.split(",").map(s=>s.trim()).filter(Boolean) : [];

  const update = {
    id: actId+"-upd-"+Date.now(),
    activityId: actId,
    loaId: mpCurrentLoa?.id || "",
    country: act?.country || mpCurrentLoa?.country || "",
    pct, status, notes,
    challenges: document.getElementById("umChallenges").value.trim(),
    mitigation: document.getElementById("umMitigation").value.trim(),
    nextSteps: document.getElementById("umNextSteps").value.trim(),
    meetingRef: document.getElementById("umMeetingRef").value.trim(),
    attachments,
    updatedBy: currentUser ? currentUser.displayName : "Unknown",
    createdAt: new Date(dateVal+"T"+new Date().toTimeString().split(" ")[0]).toISOString(),
  };

  if (!progressDB[actId]) progressDB[actId] = [];
  progressDB[actId].push(update);
  // Sort chronologically
  progressDB[actId].sort((a,b)=>new Date(a.createdAt)-new Date(b.createdAt));

  closeUpdateModal();
  // Refresh all views
  renderMpOverview();
  renderMpOutputs();
  renderMpHistory();
  renderMpAlerts();
  _saveProgressDB();
  showToast("Progress update saved! " + pct + "% — " + status, "green");
}

