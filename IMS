function renderMpOutputs() {
  const statusFilter = document.getElementById("mpActStatusFilter")?.value || "all";
  const coordFilter = document.getElementById("mpCoordFilter")?.value || "all";

  // Group activities by Output
  const outputGroups = {};
  mpCurrentActivities.forEach(a => {
    const key = a.output || "Unassigned";
    if (!outputGroups[key]) outputGroups[key] = [];
    outputGroups[key].push(a);
  });

  const container = document.getElementById("mpOutputsList");
  if (!container) return;

  if (!mpCurrentActivities.length) {
    container.innerHTML = `<div class="no-updates">No activities found for this LoA.</div>`; return;
  }

  container.innerHTML = Object.entries(outputGroups).map(([outputName, acts], oi) => {
    const filtered = acts.filter(a => {
      const hist = progressDB[a.id];
      const curStatus = hist && hist.length ? hist[hist.length-1].status : a.status;
      const mapped = mapIntStatus(a.status);
      const effStatus = hist && hist.length ? hist[hist.length-1].status : mapped;
      if (statusFilter !== "all" && effStatus !== statusFilter) return false;
      if (coordFilter !== "all" && a.focal !== coordFilter) return false;
      return true;
    });

    const totalPct = acts.map(a=>{const h=progressDB[a.id];return h&&h.length?h[h.length-1].pct:a.status==="Completed"?100:0;});
    const avgPct = totalPct.length ? Math.round(totalPct.reduce((x,y)=>x+y,0)/totalPct.length) : 0;

