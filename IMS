/* ── Utility: parse date strings robustly ────────────────────── */
function parseLoaDate(s) {
  if (!s) return null;
  // Already a Date
  if (s instanceof Date) return s;
  // Try ISO
  const d = new Date(s);
  if (!isNaN(d)) return d;
  // Try "DD Mon YYYY" / "Mon YYYY" / "YYYY" patterns
  const months = {Jan:0,Feb:1,Mar:2,Apr:3,May:4,Jun:5,Jul:6,Aug:7,Sep:8,Oct:9,Nov:10,Dec:11};
  const m1 = s.match(/^(\d{1,2})\s+(\w{3})\s+(\d{4})$/);
  if (m1) return new Date(+m1[3], months[m1[2]]||0, +m1[1]);
  const m2 = s.match(/^(\w{3})\s+(\d{4})$/);
  if (m2) return new Date(+m2[2], months[m2[1]]||0, 1);
  const m3 = s.match(/^(\d{4})$/);
  if (m3) return new Date(+m3[1], 0, 1);
  return null;
}

/* ── Auto-derive intervention status from linked LOAs ─────────── */
function deriveInterventionStatus(intRecord) {
  const allLoas = APP_DATA.loas || [];
  // Find all LOAs that list this intervention
  const linked = allLoas.filter(l => (l.interventions||[]).includes(intRecord.id));

  if (!linked.length) return "Not Started";

  const today = new Date();

  // Classify each LOA
  const active    = linked.filter(l => l.status === "Active");
  const completed = linked.filter(l => l.status === "Completed");
  const expired   = linked.filter(l => l.status === "Expired");
  const cancelled = linked.filter(l => l.status === "Cancelled");

  // All cancelled
  if (cancelled.length === linked.length) return "Cancelled";

  // Any active
  if (active.length > 0) return "In Progress";

  // All completed — check for outstanding reports
  if (completed.length === linked.length) {
    const allOutputsClean = linked.every(l =>
      (l.outputs||[]).every(o => o.status === "Completed")
    );
    return allOutputsClean ? "Completed" : "In Progress";
  }

  // Expired with outstanding deliverables
  if (expired.length > 0) {
    const hasOutstanding = linked.some(l =>
      (l.outputs||[]).some(o => o.status !== "Completed" && o.status !== "None")
    );
    return hasOutstanding ? "Delayed" : "Completed";
  }

  return intRecord.status || "Not Started";
}

/* ── Inject auto-status across all interventions ─────────────── */
function recalcAllIntStatuses() {
  const allCountries = ["fiji","samoa","solomon","regional"];
  allCountries.forEach(country => {
    (APP_DATA.interventions[country]||[]).forEach(int => {
      const linked = (APP_DATA.loas||[]).filter(l => (l.interventions||[]).includes(int.id));
      if (linked.length > 0) {
        int._derivedStatus = deriveInterventionStatus(int);
        int._hasLinkedLoas = true;
        int._linkedLoaCount = linked.length;
        int._linkedLoas = linked;
      } else {
        int._derivedStatus = null;
        int._hasLinkedLoas = false;
        int._linkedLoaCount = 0;
        int._linkedLoas = [];
      }
    });
  });
}

/* ── Build LOA summary stats for the Modality page ──────────── */
function buildLoaSummary() {
  const loas = APP_DATA.loas || [];
  const today = new Date();
  const in30 = new Date(today); in30.setDate(in30.getDate()+30);

  let totalLoas=0, activeLoas=0, completedLoas=0, expiredLoas=0, amendedLoas=0;
  let overdueReports=0, upcomingReports=0, overdueMs=0, upcomingMs=0;

  loas.forEach(l => {
    totalLoas++;
    if (l.status==="Active") activeLoas++;
    if (l.status==="Completed") completedLoas++;
    if (l.status==="Expired") expiredLoas++;
    if (l.amendments && l.amendments!=="None" && l.amendments.trim()) amendedLoas++;

    // Get workplan data: prefer LOA_WORKPLANS, fall back to normalised l.workplan
    let wp = LOA_WORKPLANS[l.id];
    if (!wp && l.workplan && l.workplan.length) {
      wp = {milestones:[], reports:[], deliverables:[]};
      l.workplan.forEach(item => {
        const entry = {date: item.date, label: item.label, status: item.status || "Pending"};
        if (item.type === "report") wp.reports.push(entry);
        else if (item.type === "deliverable") wp.deliverables.push(entry);
        else wp.milestones.push(entry);
      });
    }
    if (!wp) return;
    [...(wp.reports||[]),...(wp.deliverables||[])].forEach(r => {
      const d = parseLoaDate(r.date);
      if (!d) return;
      if (d < today && r.status !== "Completed") overdueReports++;
      else if (d >= today && d <= in30 && r.status !== "Completed") upcomingReports++;
    });
    (wp.milestones||[]).forEach(m => {
      const d = parseLoaDate(m.date);
      if (!d) return;
      if (d < today && m.status !== "Completed") overdueMs++;
      else if (d >= today && d <= in30 && m.status !== "Completed") upcomingMs++;
    });
  });

  return {totalLoas,activeLoas,completedLoas,expiredLoas,amendedLoas,
          overdueReports,upcomingReports,overdueMs,upcomingMs};
}

