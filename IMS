function mapIntStatus(s) {
  const map = {"On Track":"Ongoing","Completed":"Completed","Not Started":"Not Started","At Risk":"At Risk","Cancelled":"Not Started","Delayed":"Delayed"};
  return map[s] || s;
}

function getStatusClass(s) {
  const m = {"Not Started":"status-not-started","Ongoing":"status-ongoing","Delayed":"status-delayed","Completed":"status-completed","At Risk":"status-at-risk","On Track":"status-ongoing","Cancelled":"status-not-started"};
  return m[s] || "status-not-started";
}

function getStatusColor(pct) {
  if (pct >= 80) return "var(--green)";
  if (pct >= 40) return "var(--blue)";
  if (pct > 0)  return "var(--amber)";
  return "var(--gray3)";
}

